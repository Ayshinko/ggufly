scan_models() {
    [ -d "$MODEL_ROOT" ] || { echo "Model directory not found: $MODEL_ROOT" >&2; return 1; }
    # Scan GGUF models
    find -L "$MODEL_ROOT" -type f -iname '*.gguf' ! -iname '*mmproj*' ! -iname '*lora*' ! -iname '*kv-bias*' ! -iname '*dspark*' | sort | while IFS= read -r model; do
        if [[ "$model" =~ -([0-9]{5})-of-([0-9]{5})\.[gG][gG][uU][fF]$ ]] && [ "${BASH_REMATCH[1]}" != 00001 ]; then continue; fi
        printf '%s\n' "$model"
    done
    # Scan HuggingFace/vLLM directories (those with config.json but no GGUF)
    # Suppress known Mirai internal subdirectories (vllm, speculator) when the
    # parent is recognized as a Mirai package — prevents showing both the package
    # root and its internal directories in the selection list.
    find -L "$MODEL_ROOT" -maxdepth 3 -type f -name "config.json" ! -path "*/.git/*" 2>/dev/null | \
    while IFS= read -r config; do
        local dir
        dir=$(dirname "$config")
        # Only include if it has safetensors or bin files and no GGUF
        if find "$dir" -maxdepth 1 \( -name "*.safetensors" -o -name "*.bin" \) 2>/dev/null | grep -q .; then
            if ! find "$dir" -maxdepth 1 -name "*.gguf" 2>/dev/null | grep -q .; then
                # Skip known Mirai internal subdirectories when parent is a Mirai package.
                # This prevents showing e.g. /mnt/Storage/Model/qwen3.8-s/vllm and
                # /mnt/Storage/Model/qwen3.8-s/speculator separately.
                local parent_dir
                parent_dir=$(dirname "$dir")
                if [ -f "$parent_dir/provenance.json" ] && \
                   (grep -q '"AIR_MODEL"' "$parent_dir/provenance.json" 2>/dev/null || \
                    grep -q '"COMPOSE_' "$parent_dir/provenance.json" 2>/dev/null); then
                    continue
                fi
                if [ -f "$parent_dir/physical_package_report.json" ] && \
                   grep -q '"physical S"' "$parent_dir/physical_package_report.json" 2>/dev/null; then
                    continue
                fi
                printf '%s\n' "$dir"
            fi
        fi
    done | sort -u
}

model_info() {
    local metadata ftype origin="filename hint"
    local name="${1^^}" format=Unknown requirement="Unknown; consult the model card"

    # Handle directory-based models (HuggingFace/vLLM)
    if [ -d "$1" ]; then
        local effective_backend effective_plugin
        effective_backend=$(resolve_backend "$1")
        effective_plugin=$(resolve_plugin "$1")
        if [ "$effective_backend" = "vLLM" ]; then
            if is_mirai_model_dir "$1"; then
                echo "Mirai S model detected (vLLM checkpoint)"
                echo "Format: Mirai S (2.4-bit quantized via codec)"
            elif [ -f "$1/config.json" ]; then
                echo "HuggingFace model directory detected"
                local model_type=""
                model_type=$(jq -r '.model_type // ._name_or_path // "unknown"' "$1/config.json" 2>/dev/null || echo "unknown")
                echo "Type: $model_type"
            fi
        else
            echo "Directory model; not suitable for llama.cpp backend. Switch to vLLM."
        fi
        echo "Backend: $effective_backend"
        echo "Plugin: $effective_plugin"
        return 0
    fi

    case "$name" in
        *PTQ1_0*) format=PTQ1_0; requirement="Prism fork required" ;;
        *PQ2_0*) format=PQ2_0; requirement="Prism fork required" ;;
        *Q2_0*|*Q2_G64*) format=Q2_0; requirement="Generation/layout dependent: legacy group-128 needs old fork; official group-64 can use mainline; Bonsai 2 requires Prism fork" ;;
        *Q1_0*) format=Q1_0; requirement="Version/layout dependent; verify model card and runtime" ;;
    esac
    if metadata=$(python3 "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/prism-gguf-info.py" "$1" 2>/dev/null); then
        ftype=$(jq -r '."general.file_type" // empty' <<< "$metadata")
        format=$(jq -r '.quantization // "Unknown"' <<< "$metadata")
        origin="GGUF metadata, file_type=${ftype:-unset}"
        requirement="Verify the model card and selected backend; metadata is not a compatibility guarantee"
        echo "$metadata" | jq -r '"Name: \(."general.name" // "unknown") | Architecture: \(."general.architecture" // "unknown")"'

    fi
    echo "Format ($origin): $format | $requirement"
    echo "Filename hints cannot verify renamed GGUFs or runtime compatibility."
}

gpu_info() {
    local rows name capability architecture
    rows=$(nvidia-smi --query-gpu=name,compute_cap --format=csv,noheader 2>/dev/null) || {
        echo "NVIDIA GPU unavailable (driver/tool missing); architecture unknown."; return 0;
    }
    while IFS=, read -r name capability; do
        capability="${capability// /}"
        case "$capability" in
            8.9) architecture=Ada ;;
            8.0|8.6|8.7) architecture=Ampere ;;
            9.0) architecture=Hopper ;;
            10.*|12.*) architecture=Blackwell ;;
            7.5) architecture=Turing ;;
            *) architecture=Unknown ;;
        esac
        printf '%s | compute %s | %s\n' "$name" "$capability" "$architecture"
        [ "$architecture" != Ada ] || echo "Ada: prefer PTQ1_0 for Bonsai 2; benchmark for your workload."
    done <<< "$rows"
}

# ── vLLM / Mirai S detection ──────────────────

vllm_venv_python() {
    # Return path to python in vLLM venv, or empty string if not found.
    # Check canonical path first, then legacy fallback.
    if [ -d "$VLLM_ROOT" ] && [ -x "$VLLM_ROOT/bin/python" ]; then
        printf '%s\n' "$VLLM_ROOT/bin/python"
        return 0
    fi
    # Legacy fallback: pre-v3.5.0 location
    if [ -x "$VLLM_LEGACY_ROOT/bin/python" ]; then
        printf '%s\n' "$VLLM_LEGACY_ROOT/bin/python"
        return 0
    fi
    printf ''
    return 1
}

vllm_available() {
    local py
    py=$(vllm_venv_python) || return 1
    "$py" -c "import vllm; print(vllm.__version__)" 2>/dev/null || return 1
}

# ── Canonical plugin path resolver ────────────
# Returns the effective plugin directory for a model + plugin combination.
# If PLUGIN_DIR is explicitly set (by user), uses that.
# New architecture: plugins live under PMM_PLUGIN_DIR/<name>/<version>/.
# Returns the directory that CONTAINS site-packages (the version root
# for PMM managed, or the plugin root for legacy model-local).
effective_plugin_dir() {
    local model_path="$1" plugin="$2" explicit_dir="${PLUGIN_DIR:-}"
    if [ -n "$explicit_dir" ]; then
        printf '%s\n' "$explicit_dir"
        return
    fi
    # Normalize plugin name: 'Mirai S' -> 'mirai-s'
    local plugin_slug
    plugin_slug=$(printf '%s' "$plugin" | tr '[:upper:]' '[:lower:]' | tr ' ' '-')
    # New architecture: PMM-managed shared plugin tree
    local pmm_dir="$PMM_PLUGIN_DIR/$plugin_slug"
    if [ -d "$pmm_dir" ]; then
        # Walk version dirs and return the highest valid one's version directory
        local highest=""
        for ver_dir in "$pmm_dir"/*/; do
            [ -d "$ver_dir" ] || continue
            local base
            base=$(basename "$ver_dir")
            if [ -z "$highest" ]; then
                highest="$base"
            elif python3 -c "
import sys
from packaging.version import Version
try:
    print('yes' if Version('$base') > Version('$highest') else 'no')
except Exception:
    print('no')
" 2>/dev/null | grep -q yes; then
                highest="$base"
            fi
        done
        if [ -n "$highest" ]; then
            printf '%s/%s\n' "$pmm_dir" "$highest"
            return
        fi
    fi
    # Legacy fallback: model-local .pmm directory
    local model_dir
    if [ -f "$model_path" ]; then
        model_dir=$(dirname "$model_path")
    else
        model_dir="$model_path"
    fi
    printf '%s/.pmm/plugins/%s\n' "$model_dir" "$plugin_slug"
}

mirai_installed_at() {
    local model_path="$1"
    local dir
    dir=$(effective_plugin_dir "$model_path" "Mirai S")

    # Shared helper for verifying at a site-packages location
    _check_site() {
        local site="$1"
        [ -d "$site" ] || return 1
        local py
        py=$(vllm_venv_python 2>/dev/null || true)
        [ -x "$py" ] || return 1
        local ver
        ver=$(PYTHONPATH="$site${PYTHONPATH:+:$PYTHONPATH}" \
            "$py" -c "
import sys
from importlib import metadata
import os
site = '$site'
try:
    import mirai_s
except ImportError:
    sys.exit(1)
mod_path = os.path.realpath(mirai_s.__file__)
expected_dir = os.path.realpath(site)
if not mod_path.startswith(expected_dir + '/') and not mod_path.startswith(expected_dir):
    sys.exit(1)
matches = []
for dist in metadata.distributions(path=[site]):
    name = (dist.metadata.get('Name') or '').lower().replace('_', '-')
    if name == 'mirai-s':
        matches.append(dist.version)
if not matches:
    sys.exit(1)
print(matches[0])
" 2>/dev/null) || return 1
        if [ -n "$ver" ]; then
            printf '%s\n' "$dir"
            return 0
        fi
        return 1
    }

    # 1. Check PMM-managed shared tree: dir/site-packages (dir resolved by effective_plugin_dir)
    if _check_site "$dir/site-packages" 2>/dev/null; then
        return 0
    fi

    # 2. Check legacy model-local: <model-dir>/.pmm/plugins/mirai-s/site-packages
    local legacy_dir
    local model_dir
    if [ -f "$model_path" ]; then
        model_dir=$(dirname "$model_path")
    else
        model_dir="$model_path"
    fi
    legacy_dir="$model_dir/.pmm/plugins/mirai-s"
    if _check_site "$legacy_dir/site-packages" 2>/dev/null; then
        printf '%s\n' "$legacy_dir"
        return 0
    fi
    if [ -f "$legacy_dir/installed.txt" ]; then
        printf '%s\n' "$legacy_dir"
        return 0
    fi

    # 3. Legacy global fallback
    if [ -f "$BACKENDS_DIR/mirai_s/installed.txt" ]; then
        printf '%s\n' "$BACKENDS_DIR/mirai_s"
        return 0
    fi
    return 1
}

mirai_plugin_available() {
    # Check plugin-local first, fall back to legacy global (NOT shared vLLM venv)
    mirai_installed_at "$CURRENT_MODEL" >/dev/null 2>&1
}

# ── Mirai package detection ────────────────────
# Three states:
#  State A: Mirai package with NVIDIA vLLM payload installed (has vllm/ subdir)
#  State B: Mirai package known but NVIDIA payload missing (provenance.json exists)
#  State C: Not recognized as Mirai

# Detects a Mirai S package by inspecting its metadata files.
# Returns 0 if the path is a known Mirai package (regardless of NVIDIA payload).
is_mirai_package() {
    local dir="$1"
    [ -d "$dir" ] || return 1
    [ -f "$dir/config.json" ] || return 1

    # Test 1: provenance.json with Mirai Labs identity fields (sbt-air, COMPOSE, AIR_)
    if [ -f "$dir/provenance.json" ]; then
        if grep -q '"AIR_MODEL"' "$dir/provenance.json" 2>/dev/null ||
           grep -q '"COMPOSE_' "$dir/provenance.json" 2>/dev/null; then
            return 0
        fi
    fi

    # Test 2: physical_package_report.json with "physical S" marker
    if [ -f "$dir/physical_package_report.json" ]; then
        if grep -q '"physical S"' "$dir/physical_package_report.json" 2>/dev/null; then
            return 0
        fi
    fi

    # Test 3: config.json without standard model_type but with Mirai-specific fields
    local has_codec has_decoder
    has_codec=$(python3 -c "
import json
try:
    c = json.load(open('$dir/config.json'))
    print('yes' if 'token_codec_config' in c else 'no')
except: print('no')
" 2>/dev/null || echo "no")
    [ "$has_codec" = "yes" ] && return 0

    return 1
}

# Checks if the NVIDIA/vLLM runtime payload is installed for a Mirai package.
# Returns 0 if $package/vllm/ exists and contains expected model files.
has_mirai_nvidia_payload() {
    local package_dir="$1"
    [ -d "$package_dir/vllm" ] || return 1
    [ -f "$package_dir/vllm/config.json" ] || return 1
    # Check for Mirai plugin wheel as reliable evidence of complete payload
    ls "$package_dir/vllm/mirai_s"*.whl 2>/dev/null | grep -q . || return 1
    return 0
}

# Returns the runtime model path for a given model.
# For GGUF files: the file itself.
# For HuggingFace directories: the directory itself.
# For Mirai packages with NVIDIA payload: the vllm/ subdirectory.
runtime_model_path() {
    local model="$1"
    if [ -f "$model" ]; then
        printf '%s\n' "$model"
        return
    fi
    if [ -d "$model" ]; then
        if is_mirai_package "$model" && has_mirai_nvidia_payload "$model"; then
            printf '%s/vllm\n' "$model"
            return
        fi
        printf '%s\n' "$model"
        return
    fi
    printf '%s\n' "$model"
}

# Updated strict detection for fully-installed Mirai S model.
# Only returns 0 if the full Mirai S with NVIDIA payload is present.
is_mirai_model_dir() {
    local dir="$1"
    [ -d "$dir" ] || return 1
    is_mirai_package "$dir" || return 1
    has_mirai_nvidia_payload "$dir" || return 1
    return 0
}

find_vllm_model_dirs() {
    # Find directories that look like HuggingFace/vLLM model directories
    [ -d "$MODEL_ROOT" ] || return 0
    find -L "$MODEL_ROOT" -maxdepth 3 -type f -name "config.json" ! -path "*/.git/*" 2>/dev/null | \
    while IFS= read -r config; do
        local dir
        dir=$(dirname "$config")
        # Skip GGUF directories
        if find "$dir" -maxdepth 1 -name "*.gguf" 2>/dev/null | grep -q .; then
            continue
        fi
        printf '%s\n' "$dir"
    done | sort -u
}

resolve_backend() {
    # Return the concrete backend for a model path.
    # Never returns "Auto" or empty.
    local model_path="$1"
    if [ -n "$BACKEND" ]; then
        printf '%s\n' "$BACKEND"
        return
    fi
    # No explicit backend: detect from model format.
    if is_mirai_package "$model_path"; then
        # Known Mirai package always uses vLLM
        printf 'vLLM\n'
    elif is_mirai_model_dir "$model_path" || [ -d "$model_path/vllm" ]; then
        printf 'vLLM\n'
    elif [ -d "$model_path" ] && [ -f "$model_path/config.json" ]; then
        # HuggingFace directory: prefer vLLM if architecture is supported
        local arch
        arch=$(python3 -c "
import json
try:
    c = json.load(open('$model_path/config.json'))
    print(c.get('model_type', ''))
except: print('')
" 2>/dev/null || echo "")
        local vllm_archs=" qwen2 llama mistral mixtral gemma gemma2 phi3 phi falcon starcoder2 deepseek_v2 deepseek_v3 baichuan internlm command_r dbrx olmo qwen2_moe stablelm cohere nemotron exaone minicpm opt bloom "
        if [ -n "$arch" ] && [[ "$vllm_archs" == *" $arch "* ]]; then
            printf 'vLLM\n'
        else
            printf 'llama.cpp\n'
        fi
    else
        # GGUF file or unknown: llama.cpp
        printf 'llama.cpp\n'
    fi
}

resolve_plugin() {
    # Return the concrete plugin value. Never "Auto" or empty.
    local model_path="$1"
    if [ -n "$PLUGIN" ]; then
        printf '%s\n' "$PLUGIN"
        return
    fi
    # Auto-detect: Mirai package → Mirai S, everything else → None
    if is_mirai_package "$model_path"; then
        printf 'Mirai S\n'
    else
        printf 'None\n'
    fi
}

backend_plugin_compatible() {
    local backend="$1" plugin="$2" model_path="$3"
    case "$plugin" in
        "Mirai S")
            [ "$backend" = "vLLM" ] || return 1
            # Structural compatibility only — NOT installation or payload state.
            # The model must be a recognized Mirai S package (has provenance.json).
            [ -n "$model_path" ] || return 1
            is_mirai_package "$model_path" || return 1
            ;;
        "None")
            # Always compatible
            ;;
        *)
            return 1
            ;;
    esac
    return 0
}

# ── Model format detection ────────────────────

model_format() {
    local path="$1"
    if [ -z "$path" ] || [ ! -e "$path" ]; then
        echo '{"format":"unknown"}'
        return
    fi
    python3 "$MODEL_DETECT_PY" "$path" 2>/dev/null || echo '{"format":"unknown","reason":"detection failed"}'
}

model_format_key() {
    local path="$1" key="$2"
    model_format "$path" | python3 -c "
import sys, json
try:
    d = json.load(sys.stdin)
    print(d.get('$key', '') or '')
except: print('')
" 2>/dev/null || echo ''
}

ensure_backend() {
    local backend="$1"
    
    # Only shortcut with SERVER_BIN for llama.cpp backend
    if [ "$backend" = "llama.cpp" ]; then
        if [ -n "${PMM_SERVER_BIN:-}" ] && [ -x "${PMM_SERVER_BIN:-}" ]; then
            return 0
        fi
        if [ -x "$SERVER_BIN" ]; then
            return 0
        fi
    fi

    local status
    status=$("$BACKEND_MANAGER" status "$backend" 2>/dev/null || echo "not_installed")
    
    # Non-interactive: skip auto-install, let preflight give the real error
    if ! [ -t 0 ] || ! [ -t 1 ]; then
        case "$status" in
            installed:*) return 0 ;;
            *)
                echo "(non-interactive: backend '$backend' not installed)" >&2
                return 0  # Continue to preflight for real error
                ;;
        esac
    fi
    
    case "$status" in
        installed:*)
            return 0
            ;;
        *)
            echo ""
            echo "Required backend '$backend' is not installed."
            echo "Download and install it now?"
            echo ""
            if ! gum confirm "Install $backend?"; then
                echo "Installation cancelled by user."
                return 1
            fi
            echo ""
            echo "Installing $backend..."
            echo ""
            "$BACKEND_MANAGER" install "$backend" 2>&1 || {
                local result=$?
                echo ""
                echo "ERROR: $backend installation failed."
                echo "Check the output above for details."
                echo "You can retry: prism-backend-manager install $backend"
                return "$result"
            }
            echo ""
            echo "$backend installed successfully."
            return 0
            ;;
    esac
}

# ── Plugin helpers ────────────────────────────

# Check if the plugin is installed for this specific model or legacy
mirai_installed_for_model() {
    local model_path="$1"
    mirai_installed_at "$model_path" >/dev/null 2>&1
}

ensure_plugin() {
    local plugin="$1"
    if [ "$plugin" != "Mirai S" ]; then return 0; fi

    # Non-interactive: skip
    if ! [ -t 0 ] || ! [ -t 1 ]; then
        if mirai_installed_for_model "$CURRENT_MODEL"; then return 0; fi
        echo "(non-interactive: plugin '$plugin' not installed)" >&2
        return 0
    fi

    if mirai_installed_for_model "$CURRENT_MODEL"; then return 0; fi

    local plugin_dir
    plugin_dir=$(effective_plugin_dir "$CURRENT_MODEL" "Mirai S")
    echo ""
    echo "Mirai S plugin is not installed for this model."
    echo ""
    echo "  Model directory:       $CURRENT_MODEL"
    echo "  Plugin runtime dir:    $PMM_PLUGIN_DIR (PMM managed)"
    echo ""
    if ! gum confirm "Install Mirai S plugin now?"; then
        echo "Installation cancelled by user."
        return 1
    fi
    echo ""
    echo "Installing Mirai S plugin into $PMM_PLUGIN_DIR ..."
    echo ""
    # Pass CURRENT_MODEL so backend-manager can find the wheel
    "$BACKEND_MANAGER" install "mirai_s" "$CURRENT_MODEL" 2>&1 || {
        local result=$?
        echo ""
        echo "ERROR: Mirai S plugin installation failed."
        return "$result"
    }
    echo ""
    echo "Mirai S plugin installed successfully."
    return 0
}

# ── Mirai NVIDIA payload download ────────────
# Downloads the required vllm/ runtime payload from HuggingFace.

# Hugging Face downloader resolution.
# Returns the path to a usable hf/huggingface-cli, or empty string if none found.
# Prints diagnostic info about which location was selected.
find_hf_downloader() {
    # 1. Managed PMM vLLM environment hf command (preferred)
    if [ -x "$VLLM_ROOT/bin/hf" ]; then
        printf '%s\n' "$VLLM_ROOT/bin/hf"
        return 0
    fi
    if [ -x "$VLLM_LEGACY_ROOT/bin/hf" ]; then
        printf '%s\n' "$VLLM_LEGACY_ROOT/bin/hf"
        return 0
    fi
    # 2. Managed PMM vLLM Python with huggingface_hub module
    local vllm_py
    vllm_py=$(vllm_venv_python 2>/dev/null || true)
    if [ -n "$vllm_py" ]; then
        if "$vllm_py" -c "import huggingface_hub" 2>/dev/null; then
            printf 'python_hub:%s\n' "$vllm_py"
            return 0
        fi
    fi
    # 3. User/system hf command
    if command -v hf >/dev/null 2>&1; then
        printf '%s\n' "hf"
        return 0
    fi
    # 4. Legacy huggingface-cli
    if command -v huggingface-cli >/dev/null 2>&1; then
        printf '%s\n' "huggingface-cli"
        return 0
    fi
    # 5. System Python with huggingface_hub
    if python3 -c "import huggingface_hub" 2>/dev/null; then
        printf '%s\n' "python_system_hub"
        return 0
    fi
    # None found
    printf ''
    return 1
}

ensure_mirai_payload() {
    if [ -z "$CURRENT_MODEL" ] || [ ! -d "$CURRENT_MODEL" ]; then return 0; fi
    is_mirai_package "$CURRENT_MODEL" || return 0
    if has_mirai_nvidia_payload "$CURRENT_MODEL"; then return 0; fi

    if ! [ -t 0 ] || ! [ -t 1 ]; then
        echo "Mirai NVIDIA payload missing at $CURRENT_MODEL/vllm (non-interactive, skipping)" >&2
        return 0
    fi

    echo ""
    echo "Mirai S NVIDIA/vLLM runtime files are not installed."
    echo "This model requires the NVIDIA runtime payload (~9.3 GB)."
    echo "Download it now from HuggingFace?"
    echo ""
    if ! gum confirm "Download Mirai NVIDIA payload (9.3 GB)?"; then
        echo "Download cancelled. Plugin installation not possible without NVIDIA payload."
        return 1
    fi

    echo ""
    echo "Downloading NVIDIA runtime payload..."
    echo "  URL: trymirai/Qwen3.8-27B-S-experimental"
    echo "  Include: vllm/*, speedcheck.py"
    echo "  Target: $CURRENT_MODEL/vllm"
    echo ""

    # ── Disk space check (Python-based, float-safe, target filesystem) ──
    # Determine the target directory or its nearest existing parent
    local check_path="$CURRENT_MODEL"
    if [ ! -d "$check_path" ]; then
        # Walk up to find the first existing parent
        local parent="$check_path"
        while [ ! -d "$parent" ] && [ "$parent" != "/" ]; do
            parent=$(dirname "$parent")
        done
        check_path="$parent"
    fi

    local disk_check_result disk_check_msg
    disk_check_result=$(python3 - "$check_path" 2>/dev/null <<'PYDISK'
import json, os, shutil, sys
target = sys.argv[1]
try:
    usage = shutil.disk_usage(target)
    free_gib = usage.free / (1024**3)
    total_gib = usage.total / (1024**3)
    result = {
        "status": "ok",
        "free_gib": round(free_gib, 1),
        "total_gib": round(total_gib, 1)
    }
except OSError as e:
    result = {"status": "error", "message": str(e)}
json.dump(result, sys.stdout)
PYDISK
) || disk_check_result='{"status":"error","message":"disk check script failed"}'
    disk_check_msg=$(printf '%s' "$disk_check_result" | python3 -c "
import sys, json
d = json.load(sys.stdin)
if d.get('status') == 'ok':
    print(f\"OK:{d['free_gib']}:{d['total_gib']}\")
else:
    print(f\"ERR:{d.get('message','unknown error')}\")
" 2>/dev/null || echo "ERR:disk check parsing failed")

    local disk_free_gib=""
    if [[ "$disk_check_msg" == OK:* ]]; then
        disk_free_gib="${disk_check_msg#OK:}"
        disk_free_gib="${disk_free_gib%%:*}"
        echo "  Free space on target filesystem: ${disk_free_gib} GiB"
        echo "  NVIDIA payload requires approximately 9.3 GiB."
        echo ""

        # Float-safe comparison using Python
        local too_low
        too_low=$(python3 -c "
free = float('${disk_free_gib}')
print('yes' if 0 < free < 12 else 'no')
" 2>/dev/null || echo "no")
        if [ "$too_low" = "yes" ]; then
            echo "WARNING: Only ${disk_free_gib} GiB free. Need ~10+ GiB for NVIDIA payload."
            if ! gum confirm "Continue with limited disk space?"; then
                echo "Download cancelled."
                return 1
            fi
        fi
    else
        local disk_err="${disk_check_msg#ERR:}"
        echo "WARNING: Could not check disk space on target filesystem: $disk_err"
        echo "Proceeding without space verification."
    fi

    # ── Find a usable downloader ──
    local downloader
    downloader=$(find_hf_downloader) || true
    if [ -z "$downloader" ]; then
        echo ""
        echo "ERROR: No usable Hugging Face downloader was found."
        echo ""
        echo "Checked locations:"
        echo "  1. Managed vLLM environment: $VLLM_ROOT/bin/hf"
        echo "  2. Managed vLLM Python: $(vllm_venv_python 2>/dev/null || echo 'not found')"
        echo "  3. System command: hf"
        echo "  4. System command: huggingface-cli"
        echo "  5. System Python: huggingface_hub module"
        echo ""
        echo "How to get a downloader:"
        echo "  prism-backend-manager install vllm     # PMM-managed environment, includes huggingface_hub"
        echo "  pip install huggingface_hub              # System Python"
        echo "  sudo pacman -S git-lfs                   # Last resort"
        return 1
    fi

    mkdir -p "$CURRENT_MODEL/vllm"

    # ── Execute download ──
    local download_ok=0
    local download_stderr=""
    case "$downloader" in
        *"/bin/hf")
            echo "Using managed vLLM hf ($downloader)..."
            echo "  hf download trymirai/Qwen3.8-27B-S-experimental"
            echo "    --include 'vllm/*'"
            echo "    --include 'speedcheck.py'"
            echo "    --local-dir '$CURRENT_MODEL'"
            if download_stderr=$("$downloader" download trymirai/Qwen3.8-27B-S-experimental \
                --include "vllm/*" --include "speedcheck.py" \
                --local-dir "$CURRENT_MODEL" 2>&1); then
                download_ok=1
            else
                echo "$download_stderr"
            fi
            ;;
        "python_hub:"*)
            local hub_py="${downloader#python_hub:}"
            echo "Using managed vLLM Python + huggingface_hub ($hub_py)..."
            if download_stderr=$("$hub_py" -c "
import sys
from huggingface_hub import snapshot_download
try:
    snapshot_download(
        repo_id='trymirai/Qwen3.8-27B-S-experimental',
        local_dir='$CURRENT_MODEL',
        allow_patterns=['vllm/*', 'speedcheck.py'],
        ignore_patterns=['uzu/*'],
    )
except Exception as e:
    print(f'Download failed: {e}', file=sys.stderr)
    sys.exit(1)
" 2>&1); then
                download_ok=1
            else
                echo "$download_stderr"
            fi
            ;;
        "hf")
            echo "Using system hf..."
            if hf download trymirai/Qwen3.8-27B-S-experimental \
                --include "vllm/*" --include "speedcheck.py" \
                --local-dir "$CURRENT_MODEL" 2>&1; then
                download_ok=1
            fi
            ;;
        "huggingface-cli")
            echo "Using huggingface-cli..."
            if huggingface-cli download trymirai/Qwen3.8-27B-S-experimental \
                --include "vllm/*" --include "speedcheck.py" \
                --local-dir "$CURRENT_MODEL" 2>&1; then
                download_ok=1
            fi
            ;;
        "python_system_hub")
            echo "Using system Python + huggingface_hub..."
            if python3 -c "
import sys
from huggingface_hub import snapshot_download
try:
    snapshot_download(
        repo_id='trymirai/Qwen3.8-27B-S-experimental',
        local_dir='$CURRENT_MODEL',
        allow_patterns=['vllm/*', 'speedcheck.py'],
        ignore_patterns=['uzu/*'],
    )
except Exception as e:
    print(f'Download failed: {e}', file=sys.stderr)
    sys.exit(1)
" 2>&1; then
                download_ok=1
            fi
            ;;
        *)
            echo "ERROR: Unknown downloader type: $downloader"
            ;;
    esac

    if [ "$download_ok" -eq 1 ]; then
        # ── Verify download completion ──
        if has_mirai_nvidia_payload "$CURRENT_MODEL"; then
            echo ""
            echo "NVIDIA payload downloaded and verified successfully."
            return 0
        else
            echo ""
            echo "WARNING: Download completed but payload verification failed."
            echo "Expected files: vllm/config.json, trellis.mirai, model.safetensors.index.json"
            echo "Check $CURRENT_MODEL/vllm/ for partial content."
            echo "PMM will prompt again next time if payload is incomplete."
            return 1
        fi
    fi

    # Download failed — provide specific guidance not "network problem"
    echo ""
    if [ -n "$download_stderr" ]; then
        if echo "$download_stderr" | grep -qi "no such option\|unsupported\|invalid option"; then
            echo "ERROR: The downloader reported an unsupported option."
            echo "This is an internal PMM issue — the download command used an obsolete flag."
            echo "Please report this bug."
        elif echo "$download_stderr" | grep -qi "authentication\|401\|forbidden\|access denied\|token"; then
            echo "ERROR: Hugging Face authentication/access failure."
            echo "Check your Hugging Face token or if the repository is accessible."
        elif echo "$download_stderr" | grep -qi "timeout\|connection refused\|name resolution\|network\|Could not resolve host"; then
            echo "ERROR: Network error connecting to Hugging Face."
            echo "Check your internet connection."
        else
            echo "ERROR: NVIDIA/vLLM model variant download failed."
            echo "$download_stderr" | tail -5
        fi
    else
        echo "ERROR: NVIDIA/vLLM model variant download failed."
        echo "Check your network connection and Hugging Face access."
    fi

    # ── Fallback: try git LFS ──
    if command -v git >/dev/null 2>&1 && command -v git-lfs >/dev/null 2>&1; then
        echo "Downloader failed, trying git LFS..."
        local old_dir="$PWD"
        cd "$CURRENT_MODEL" || return 1
        if [ ! -d ".git" ]; then
            GIT_LFS_SKIP_SMUDGE=1 git init
            git remote add origin https://huggingface.co/trymirai/Qwen3.8-27B-S-experimental
            git fetch --depth 1 origin main 2>&1 || { cd "$old_dir"; return 1; }
            git checkout main -- vllm/ speedcheck.py 2>&1
        else
            git lfs pull --include "vllm/*" 2>&1 || true
        fi
        cd "$old_dir"
        if has_mirai_nvidia_payload "$CURRENT_MODEL"; then
            echo "NVIDIA payload downloaded successfully via git."
            return 0
        fi
        echo "Git LFS download also incomplete."
        return 1
    fi

    echo ""
    echo "ERROR: NVIDIA payload download failed."
    echo "Check your network connection and Hugging Face access."
    return 1
}

validate_settings() {
    python3 - "$CTX" "$NGL" "$BATCH" "$UBATCH" "$PARALLEL" "$PORT" "$TEMP" "$TOP_P" "$TOP_K" "$MIN_P" "$REASONING_BUDGET" "$MAX_OUTPUT_TOKENS" "$LORA_SCALE" "$MTP_DRAFT_MAX" "$STARTUP_TIMEOUT" <<'PY' || return 1
import math, re, sys
names = 'CTX NGL BATCH UBATCH PARALLEL PORT TEMP TOP_P TOP_K MIN_P REASONING_BUDGET MAX_OUTPUT_TOKENS LORA_SCALE MTP_DRAFT_MAX STARTUP_TIMEOUT'.split()
v = dict(zip(names, sys.argv[1:]))
try:
    for name in names:
        text = v[name]
        if name not in ('TEMP', 'TOP_P', 'MIN_P', 'LORA_SCALE'):
            if not re.fullmatch(r'-?(0|[1-9][0-9]*)', text):
                raise ValueError(f'{name} must be an integer without leading zeros')
        number = float(text)
        if not math.isfinite(number): raise ValueError(f'{name} must be finite')
        low, high = {
            'NGL': (-1, 2147483647), 'PORT': (1, 65535),
            'TEMP': (0, 100), 'TOP_P': (0, 1), 'MIN_P': (0, 1),
            'TOP_K': (0, 2147483647), 'REASONING_BUDGET': (-1, 2147483647),
            'MAX_OUTPUT_TOKENS': (-1, 2147483647),
            'LORA_SCALE': (-100, 100), 'STARTUP_TIMEOUT': (1, 86400),
        }.get(name, (1, 2147483647))
        if not low <= number <= high: raise ValueError(f'{name} must be between {low} and {high}')
    if int(v['UBATCH']) > int(v['BATCH']): raise ValueError('UBATCH must not exceed BATCH')
    if int(v['PARALLEL']) > int(v['CTX']): raise ValueError('PARALLEL must not exceed CTX')
except ValueError as exc:
    print(f'Invalid settings: {exc}', file=sys.stderr)
    sys.exit(1)
PY
    local effective_backend
    effective_backend=$(resolve_backend "$CURRENT_MODEL")
    local effective_plugin
    effective_plugin=$(resolve_plugin "$CURRENT_MODEL")

    # Common validation
    [ -n "$HOST" ] && [[ "$HOST" != *[[:space:]/]* ]] || { echo "HOST must be a hostname or IP address without a URL scheme." >&2; return 1; }

    # Backend-specific validation
    if [ "$effective_backend" = "llama.cpp" ]; then
        local field
        for field in VISION MTP LORA_ENABLED; do
            [[ "${!field}" =~ ^(on|off)$ ]] || { echo "Invalid $field: use on/off." >&2; return 1; }
        done
        [[ "$FLASH" =~ ^(on|off|auto)$ ]] || { echo "Invalid FLASH: use on/off/auto." >&2; return 1; }
        for field in CACHE_K CACHE_V; do
            [[ "${!field}" =~ ^(f32|f16|bf16|q8_0|q4_0|q4_1|q5_0|q5_1|iq4_nl)$ ]] || { echo "Invalid $field cache type." >&2; return 1; }
        done
        [[ "$MTP_DRAFT_FLAG" =~ ^--(draft-max|spec-draft-n-max)$ ]] || { echo "Invalid MTP draft flag." >&2; return 1; }
        [[ "$MTP_MODE" =~ ^(mtp|draft-mtp)$ ]] || { echo "MTP mode must be mtp or draft-mtp, as advertised by your backend." >&2; return 1; }
        if [ "$LORA_ENABLED" = on ] && [ ! -r "$LORA_PATH" ]; then echo "LoRA file not readable: $LORA_PATH" >&2; return 1; fi
    fi

    # Plugin structural compatibility (NOT installation or payload check)
    if [ "$effective_plugin" = "Mirai S" ]; then
        if [ "$effective_backend" != "vLLM" ]; then
            echo "Mirai S plugin requires vLLM backend." >&2; return 1
        fi
        # Accept Mirai packages even without NVIDIA payload (will be downloaded later)
        is_mirai_package "$CURRENT_MODEL" || {
            echo "Model is not recognized as a Mirai S package." >&2
            echo "Mirai packages require provenance-like metadata in the model directory." >&2
            return 1
        }
    fi
}

api_base() (
    local RUN_HOST="$HOST" RUN_PORT="$PORT" RUN_MODEL=""
    if server_pid >/dev/null && [ -f "$STATE_DIR/runtime.env" ]; then
        # shellcheck disable=SC1091
        source "$STATE_DIR/runtime.env"
    fi
    case "$RUN_HOST" in
        0.0.0.0) RUN_HOST=127.0.0.1 ;;
        ::) RUN_HOST=::1 ;;
    esac
    [[ "$RUN_HOST" != *:* ]] || RUN_HOST="[$RUN_HOST]"
    printf 'http://%s:%s' "$RUN_HOST" "$RUN_PORT"
)

port_available() {
    python3 - "$HOST" "$PORT" <<'PY'
import socket, sys
try:
    addresses = socket.getaddrinfo(sys.argv[1], int(sys.argv[2]), type=socket.SOCK_STREAM)
    for family, kind, protocol, _, address in addresses:
        with socket.socket(family, kind, protocol) as sock:
            sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            sock.bind(address)
except (OSError, ValueError) as exc:
    print(f'Cannot bind {sys.argv[1]}:{sys.argv[2]}: {exc}. Choose another host/port; no process was stopped.', file=sys.stderr)
    sys.exit(1)
PY
}

backend_supports() {
    jq -e --arg flag "$1" 'has($flag) and (.[$flag].removed | not)' <<< "$BACKEND_OPTIONS" >/dev/null
}

preflight() {
    [ -e "$CURRENT_MODEL" ] || { echo "Model file or directory missing: $CURRENT_MODEL" >&2; return 1; }
    validate_settings || return 1

    local effective_backend
    effective_backend=$(resolve_backend "$CURRENT_MODEL")

    if [ "$effective_backend" = "vLLM" ]; then
        # vLLM preflight: verify venv, model directory
        local py
        py=$(vllm_venv_python) || { echo "vLLM venv not found at $VLLM_ROOT. Install vLLM first." >&2; return 1; }
        local effective_plugin
        effective_plugin=$(resolve_plugin "$CURRENT_MODEL")
        if [ "$effective_plugin" = "Mirai S" ]; then
            is_mirai_model_dir "$CURRENT_MODEL" || { echo "Selected model is not a valid Mirai S model directory." >&2; return 1; }
        fi
        build_command
        return 0
    fi

    # llama.cpp preflight: existing logic
    [ -x "$SERVER_BIN" ] || { echo "Set PMM_SERVER_BIN to an executable llama-server." >&2; return 1; }
    python3 "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/prism-gguf-info.py" "$CURRENT_MODEL" >/dev/null || return 1
    python3 - "$CURRENT_MODEL" <<'CHECK' || return 1
import pathlib, re, sys
p = pathlib.Path(sys.argv[1])
m = re.fullmatch(r'(.*)-(\d{5})-of-(\d{5})(\.[gG][gG][uU][fF])', p.name)
if m:
    count = int(m[3])
    if m[2] != '00001' or count < 1 or count > 99999:
        sys.exit('Select the first valid GGUF shard.')
    for i in range(1, count + 1):
        shard = p.with_name(f'{m[1]}-{i:05d}-of-{count:05d}{m[4]}')
        if not shard.is_file(): sys.exit(f'Missing GGUF shard: {shard.name}')
CHECK
    local BACKEND_HELP BACKEND_OPTIONS
    BACKEND_HELP=$(timeout 10 "$SERVER_BIN" --help 2>&1) || { echo "Backend --help failed or timed out: $SERVER_BIN" >&2; printf '%s\n' "$BACKEND_HELP" | tail -8 >&2; return 1; }
    BACKEND_OPTIONS=$(python3 "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/prism-backend-info.py" <<< "$BACKEND_HELP") || {
        echo "Unable to parse backend help." >&2; return 1;
    }
    local flag
    for flag in -m --host --port -ngl -fa -c -b -ub -np -n --temp --top-p --top-k --min-p --cache-type-k --cache-type-v --jinja; do
        backend_supports "$flag" || { echo "Backend does not advertise $flag; choose a compatible existing build." >&2; return 1; }
    done
    if [ "$VISION" = on ]; then
        if [ -n "$MMPROJ_PATH" ]; then
            backend_supports --mmproj || { echo "Backend does not advertise vision --mmproj support." >&2; return 1; }
            VISION_ARG_MODE="path"
        elif backend_supports --mmproj-auto; then
            VISION_ARG_MODE="auto"
        elif backend_supports --mmproj; then
            find_mmproj >/dev/null || return 1
            VISION_ARG_MODE="path"
        else
            echo "Backend does not advertise --mmproj-auto or --mmproj support." >&2
            return 1
        fi
    fi
    if [ "$MTP" = on ]; then
        if jq -e --arg flag "$MTP_DRAFT_FLAG" '.[$flag].removed == true' <<< "$BACKEND_OPTIONS" >/dev/null; then
            echo "Backend marks $MTP_DRAFT_FLAG as removed. Its description:" >&2
            jq -r --arg flag "$MTP_DRAFT_FLAG" '.[$flag].description' <<< "$BACKEND_OPTIONS" >&2
            return 1
        fi
        if ! backend_supports --spec-type || ! backend_supports "$MTP_DRAFT_FLAG"; then
            echo "Backend does not advertise --spec-type and $MTP_DRAFT_FLAG. Check the selected executable's --help." >&2
            return 1
        fi
        if ! jq -e --arg mode "$MTP_MODE" '."--spec-type".values | index($mode) != null' <<< "$BACKEND_OPTIONS" >/dev/null; then
            echo "Unsupported MTP mode '$MTP_MODE'. Backend advertises: $(jq -r '."--spec-type".usage' <<< "$BACKEND_OPTIONS"). Set MTP mode in Model / Backend Settings." >&2
            return 1
        fi
    fi

    if [ "$MTP" = on ] && [ "$LEGACY_SPEC_DRAFT_MODEL_SET" -eq 1 ]; then
        echo "Legacy SPEC_DRAFT_MODEL was migrated as embedded MTP; no sidecar draft model is used." >&2
    fi

    if [ "$LORA_ENABLED" = on ]; then
        backend_supports --lora-scaled || { echo "Backend lacks --lora-scaled." >&2; return 1; }
    fi
    if [ "$REASONING_BUDGET" != -1 ]; then
        backend_supports --reasoning-budget || { echo "Backend lacks --reasoning-budget." >&2; return 1; }
    fi
    build_command
}

runtime_status() {
    if server_pid >/dev/null; then
        if server_health; then echo 'RUNNING (managed)'; else echo 'LOADING / UNHEALTHY (managed; see logs)'; fi
    elif server_health; then
        echo 'EXTERNAL SERVER (not managed)'
    else
        echo 'STOPPED / no healthy API'
    fi
}

runtime_state_status() {
    if server_pid >/dev/null; then
        echo "MANAGED: PID $(server_pid), verified by process start time and boot ID"
        return 0
    fi
    if server_health; then
        echo "EXTERNAL: healthy API at $(api_base), not managed by this process"
        return 0
    fi
    if [ -e "$PIDFILE" ] || [ -e "$PIDFILE.start" ] || [ -e "$PIDFILE.boot" ] || [ -e "$STATE_DIR/runtime.env" ]; then
        echo "STALE: runtime metadata is present, but no verified managed process or healthy API exists"
        return 2
    fi
    echo "STOPPED: no managed process or runtime metadata"
    return 0
}

clear_stale_state() {
    if server_pid >/dev/null; then
        echo "Refusing to clear metadata for a verified managed process." >&2
        return 1
    fi
    if server_health; then
        echo "Refusing to clear metadata while an external healthy API is present." >&2
        return 1
    fi
    rm -f "$PIDFILE" "$PIDFILE.start" "$PIDFILE.boot" "$STATE_DIR/runtime.env"
    echo "Cleared stale runtime metadata; no process was adopted or stopped."
}

memory_status() {
    nvidia-smi --query-gpu=name,memory.used,memory.total,utilization.gpu --format=csv,noheader 2>/dev/null || echo 'NVIDIA usage unavailable (driver/tool missing).'
    awk '/MemTotal:/ {total=$2} /MemAvailable:/ {available=$2} END {if (total) printf "RAM: %.1f / %.1f GiB used (available: %.1f GiB)\n", (total-available)/1048576, total/1048576, available/1048576}' /proc/meminfo
}

build_command() {
    local effective_backend
    effective_backend=$(resolve_backend "$CURRENT_MODEL")

    if [ "$effective_backend" = "vLLM" ]; then
        build_vllm_command
    else
        build_llamacpp_command
    fi
}

build_llamacpp_command() {
    [ -x "$SERVER_BIN" ] || { echo "Set PMM_SERVER_BIN to an executable llama-server." >&2; return 1; }
    [ -f "$CURRENT_MODEL" ] || { echo "Model file missing." >&2; return 1; }
    validate_settings || return 1
    SERVER_ARGS=(
        "$SERVER_BIN"
        -m "$CURRENT_MODEL"
        --host "$HOST"
        --port "$PORT"
        -ngl "$NGL"
        -fa "$FLASH"
        -c "$CTX"
        -b "$BATCH"
        -ub "$UBATCH"
        -np "$PARALLEL"
        -n "$MAX_OUTPUT_TOKENS"
        --temp "$TEMP"
        --top-p "$TOP_P"
        --top-k "$TOP_K"
        --min-p "$MIN_P"
        --cache-type-k "$CACHE_K"
        --cache-type-v "$CACHE_V"
        --jinja
    )

    if [ "$LORA_ENABLED" = "on" ]; then
        SERVER_ARGS+=(--lora-scaled "$LORA_PATH:$LORA_SCALE")
    fi

    if [ "$REASONING_BUDGET" != "-1" ]; then
        SERVER_ARGS+=(--reasoning-budget "$REASONING_BUDGET")
    fi

    if [ "$VISION" = "on" ]; then
        if [ -n "$MMPROJ_PATH" ]; then
            local mmproj
            mmproj=$(find_mmproj) || return 1
            SERVER_ARGS+=(--mmproj "$mmproj")
        elif [ "${VISION_ARG_MODE:-}" = "auto" ]; then
            SERVER_ARGS+=(--mmproj-auto)
        else
            local mmproj
            mmproj=$(find_mmproj) || return 1
            SERVER_ARGS+=(--mmproj "$mmproj")
        fi
    fi
    if [ "$MTP" = on ]; then
        SERVER_ARGS+=(--spec-type "$MTP_MODE" "$MTP_DRAFT_FLAG" "$MTP_DRAFT_MAX")
    fi
}

build_vllm_command() {
    local py
    py=$(vllm_venv_python) || { echo "vLLM venv not found at $VLLM_ROOT." >&2; return 1; }

    validate_settings || return 1

    local effective_plugin
    effective_plugin=$(resolve_plugin "$CURRENT_MODEL")

    # vLLM serve command — use RUNTIME model path, not the package root
    local model_path runtime_path
    model_path="$CURRENT_MODEL"
    runtime_path=$(runtime_model_path "$CURRENT_MODEL")
    local served_model_name
    served_model_name=$(basename "$model_path")

    # Build the base command (python -m vllm.entrypoints...)
    local -a cmd
    cmd=(
        "$py"
        -m vllm.entrypoints.openai.api_server
        --model "$runtime_path"
        --host "$HOST"
        --port "$PORT"
        --served-model-name "$served_model_name"
        --gpu-memory-utilization "$VLLM_GPU_MEMORY_UTIL"
        --max-model-len "$VLLM_MAX_MODEL_LEN"
        --max-num-seqs "$VLLM_MAX_NUM_SEQS"
        --max-num-batched-tokens "$VLLM_MAX_BATCHED_TOKENS"
        --enable-auto-tool-choice
        --tool-call-parser qwen3_coder
    )

    if [ "$effective_plugin" = "Mirai S" ]; then
        local plugin_dir
        plugin_dir=$(effective_plugin_dir "$CURRENT_MODEL" "Mirai S")
        # Build SERVER_ARGS with env prefix for process-scoped PYTHONPATH.
        # This prevents "PYTHONPATH=..." from being treated as argv[0].
        # Preserve any existing PYTHONPATH at launch time.
        local site_pkgs="$plugin_dir/site-packages"
        if [ -d "$site_pkgs" ]; then
            # Use env so the variable is set in the child's environment, not argv
            SERVER_ARGS=(
                env
                "PYTHONPATH=$site_pkgs${PYTHONPATH:+:$PYTHONPATH}"
                "${cmd[@]}"
            )
        else
            SERVER_ARGS=("${cmd[@]}")
        fi
        SERVER_ARGS+=(--reasoning-parser qwen3)
        if [ "$MTP" = "on" ]; then
            SERVER_ARGS+=(--speculative-config '{"method":"mtp","num_speculative_tokens":4}')
        fi
    else
        SERVER_ARGS=("${cmd[@]}")
    fi

    if [ "$MAX_OUTPUT_TOKENS" != "-1" ]; then
        # Only affects llama.cpp; vLLM handles via per-request max_tokens
        :
    fi
}

save_config() {
    local temporary
    temporary=$(mktemp "$CONFIG.XXXXXX") || return 1
    {
        if [ -z "${PMM_MODEL_ROOT:-}" ] || [ "$CONFIG_HAS_MODEL_ROOT" -eq 1 ]; then
            if [ -n "${PMM_MODEL_ROOT:-}" ]; then printf 'MODEL_ROOT=%q\n' "$SAVED_MODEL_ROOT"; else printf 'MODEL_ROOT=%q\n' "$MODEL_ROOT"; fi
        fi
        if [ -z "${PMM_PRISM_ROOT:-}" ] || [ "$CONFIG_HAS_PRISM_ROOT" -eq 1 ]; then
            if [ -n "${PMM_PRISM_ROOT:-}" ]; then printf 'PRISM_ROOT=%q\n' "$SAVED_PRISM_ROOT"; else printf 'PRISM_ROOT=%q\n' "$PRISM_ROOT"; fi
        fi

        if [ -z "${PMM_SERVER_BIN:-}" ] || [ "$CONFIG_HAS_SERVER_BIN" -eq 1 ]; then
            if [ -n "${PMM_SERVER_BIN:-}" ]; then printf 'SERVER_BIN=%q\n' "$SAVED_SERVER_BIN"; else printf 'SERVER_BIN=%q\n' "$SERVER_BIN"; fi
        fi
        if [ -z "${PMM_BENCH_BIN:-}" ] || [ "$CONFIG_HAS_BENCH_BIN" -eq 1 ]; then
            if [ -n "${PMM_BENCH_BIN:-}" ]; then printf 'BENCH_BIN=%q\n' "$SAVED_BENCH_BIN"; else printf 'BENCH_BIN=%q\n' "$BENCH_BIN"; fi
        fi
        printf 'HOST=%q\n' "$HOST"
        printf 'PORT=%q\n' "$PORT"
        printf 'STARTUP_TIMEOUT=%q\n' "$STARTUP_TIMEOUT"

        printf 'CTX=%q\n' "$CTX"
        printf 'NGL=%q\n' "$NGL"
        printf 'FLASH=%q\n' "$FLASH"

        printf 'BATCH=%q\n' "$BATCH"
        printf 'UBATCH=%q\n' "$UBATCH"
        printf 'PARALLEL=%q\n' "$PARALLEL"

        printf 'TEMP=%q\n' "$TEMP"
        printf 'TOP_P=%q\n' "$TOP_P"
        printf 'TOP_K=%q\n' "$TOP_K"
        printf 'MIN_P=%q\n' "$MIN_P"

        printf 'CACHE_K=%q\n' "$CACHE_K"
        printf 'CACHE_V=%q\n' "$CACHE_V"

        printf 'REASONING_BUDGET=%q\n' "$REASONING_BUDGET"
        printf 'MAX_OUTPUT_TOKENS=%q\n' "$MAX_OUTPUT_TOKENS"
        printf 'VISION=%q\n' "$VISION"
        printf 'MMPROJ_PATH=%q\n' "$MMPROJ_PATH"
        printf 'MTP=%q\n' "$MTP"
        printf 'MTP_MODE=%q\n' "$MTP_MODE"
        printf 'MTP_DRAFT_MAX=%q\n' "$MTP_DRAFT_MAX"
        printf 'MTP_DRAFT_FLAG=%q\n' "$MTP_DRAFT_FLAG"

        printf 'LORA_ENABLED=%q\n' "$LORA_ENABLED"
        printf 'LORA_SCALE=%q\n' "$LORA_SCALE"
        printf 'LORA_PATH=%q\n' "$LORA_PATH"

        printf 'BACKEND=%q\n' "$BACKEND"
        printf 'PLUGIN=%q\n' "$PLUGIN"

        printf 'VLLM_ROOT=%q\n' "$VLLM_ROOT"
        printf 'VLLM_GPU_MEMORY_UTIL=%q\n' "$VLLM_GPU_MEMORY_UTIL"
        printf 'VLLM_MAX_MODEL_LEN=%q\n' "$VLLM_MAX_MODEL_LEN"
        printf 'VLLM_MAX_NUM_SEQS=%q\n' "$VLLM_MAX_NUM_SEQS"
        printf 'VLLM_MAX_BATCHED_TOKENS=%q\n' "$VLLM_MAX_BATCHED_TOKENS"

        printf 'CURRENT_MODEL=%q\n' "$CURRENT_MODEL"
    } > "$temporary" && mv -f -- "$temporary" "$CONFIG"
}

model_profile_file() {
    local key
    key=$(printf '%s' "$CURRENT_MODEL" | sha256sum | awk '{print $1}')
    printf '%s/%s.env\n' "$MODEL_PROFILE_DIR" "$key"
}

reset_model_runtime_defaults() {
    CTX="$DEFAULT_CTX"
    NGL="$DEFAULT_NGL"
    FLASH="$DEFAULT_FLASH"

    BATCH="$DEFAULT_BATCH"
    UBATCH="$DEFAULT_UBATCH"
    PARALLEL="$DEFAULT_PARALLEL"

    TEMP="$DEFAULT_TEMP"
    TOP_P="$DEFAULT_TOP_P"
    TOP_K="$DEFAULT_TOP_K"
    MIN_P="$DEFAULT_MIN_P"

    CACHE_K="$DEFAULT_CACHE_K"
    CACHE_V="$DEFAULT_CACHE_V"

    REASONING_BUDGET="$DEFAULT_REASONING_BUDGET"
    MAX_OUTPUT_TOKENS="$DEFAULT_MAX_OUTPUT_TOKENS"
    VISION="$DEFAULT_VISION"
    MMPROJ_PATH="$DEFAULT_MMPROJ_PATH"
    MTP="$DEFAULT_MTP"
    MTP_MODE="$DEFAULT_MTP_MODE"
    MTP_DRAFT_MAX="$DEFAULT_MTP_DRAFT_MAX"
    MTP_DRAFT_FLAG="$DEFAULT_MTP_DRAFT_FLAG"

    LORA_ENABLED="$DEFAULT_LORA_ENABLED"
    LORA_SCALE="$DEFAULT_LORA_SCALE"
    LORA_PATH="$DEFAULT_LORA_PATH"
    BACKEND="$DEFAULT_BACKEND"
    PLUGIN="$DEFAULT_PLUGIN"
    PLUGIN_DIR="$DEFAULT_PLUGIN_DIR"
    VLLM_GPU_MEMORY_UTIL="$DEFAULT_VLLM_GPU_MEMORY_UTIL"
    VLLM_MAX_MODEL_LEN="$DEFAULT_VLLM_MAX_MODEL_LEN"
    VLLM_MAX_NUM_SEQS="$DEFAULT_VLLM_MAX_NUM_SEQS"
    VLLM_MAX_BATCHED_TOKENS="$DEFAULT_VLLM_MAX_BATCHED_TOKENS"
}

save_model_profile() {
    [ -n "$CURRENT_MODEL" ] || return 0

    local profile
    profile=$(model_profile_file)
    local temporary
    temporary=$(mktemp "$profile.XXXXXX") || return 1

    {
        printf 'CTX=%q\n' "$CTX"
        printf 'NGL=%q\n' "$NGL"
        printf 'FLASH=%q\n' "$FLASH"

        printf 'BATCH=%q\n' "$BATCH"
        printf 'UBATCH=%q\n' "$UBATCH"
        printf 'PARALLEL=%q\n' "$PARALLEL"

        printf 'TEMP=%q\n' "$TEMP"
        printf 'TOP_P=%q\n' "$TOP_P"
        printf 'TOP_K=%q\n' "$TOP_K"
        printf 'MIN_P=%q\n' "$MIN_P"

        printf 'CACHE_K=%q\n' "$CACHE_K"
        printf 'CACHE_V=%q\n' "$CACHE_V"

        printf 'REASONING_BUDGET=%q\n' "$REASONING_BUDGET"
        printf 'MAX_OUTPUT_TOKENS=%q\n' "$MAX_OUTPUT_TOKENS"
        printf 'VISION=%q\n' "$VISION"
        printf 'MMPROJ_PATH=%q\n' "$MMPROJ_PATH"
        printf 'MTP=%q\n' "$MTP"
        printf 'MTP_MODE=%q\n' "$MTP_MODE"
        printf 'MTP_DRAFT_MAX=%q\n' "$MTP_DRAFT_MAX"
        printf 'MTP_DRAFT_FLAG=%q\n' "$MTP_DRAFT_FLAG"

        printf 'LORA_ENABLED=%q\n' "$LORA_ENABLED"
        printf 'LORA_SCALE=%q\n' "$LORA_SCALE"
        printf 'LORA_PATH=%q\n' "$LORA_PATH"

        printf 'BACKEND=%q\n' "$BACKEND"
        printf 'PLUGIN=%q\n' "$PLUGIN"

        printf 'PLUGIN_DIR=%q\n' "$PLUGIN_DIR"
        printf 'VLLM_GPU_MEMORY_UTIL=%q\n' "$VLLM_GPU_MEMORY_UTIL"
        printf 'VLLM_MAX_MODEL_LEN=%q\n' "$VLLM_MAX_MODEL_LEN"
        printf 'VLLM_MAX_NUM_SEQS=%q\n' "$VLLM_MAX_NUM_SEQS"
        printf 'VLLM_MAX_BATCHED_TOKENS=%q\n' "$VLLM_MAX_BATCHED_TOKENS"
    } > "$temporary" && mv -f -- "$temporary" "$profile"
}

load_model_profile() {
    [ -n "$CURRENT_MODEL" ] || return 1

    reset_model_runtime_defaults

    local profile
    profile=$(model_profile_file)

    if [ -f "$profile" ]; then
        # shellcheck disable=SC1090
        source "$profile"
    fi

    # ── Migrate legacy PLUGIN_DIR ──────────────────────────────
    # Old profiles stored PLUGIN_DIR under the model-local .pmm path:
    #   <model-dir>/.pmm/plugins/<plugin>
    # The new architecture uses PMM-managed plugin tree:
    #   ~/.local/share/prism-model-manager/plugins/<name>/<version>/site-packages
    # Migrate by clearing PLUGIN_DIR so effective_plugin_dir() resolves
    # the PMM-managed installation automatically.
    if [ -n "$PLUGIN_DIR" ]; then
        local expected_legacy
        expected_legacy=$(effective_plugin_dir "$CURRENT_MODEL" "None" 2>/dev/null || echo "")
        # effective_plugin_dir with plugin=None returns the .pmm/plugins/None directory
        # Check if PLUGIN_DIR is under <model-root>/.pmm/
        if [ -n "$CURRENT_MODEL" ] && [[ "$PLUGIN_DIR" == */.pmm/plugins/* ]]; then
            debug "  Migrating legacy PLUGIN_DIR='$PLUGIN_DIR' -> clearing for PMM-managed plugin tree"
            PLUGIN_DIR=""
        fi
    fi
}

pause() {
    echo
    read -r -p "Press Enter to continue..." || true
}

title() {
    clear
    local cols="${TERM_COLS:-80}"
    [ "$cols" -gt 120 ] && cols=120
    printf '%b' "$C_CYAN$C_BOLD"
    printf '%s\n' "  Prism Model Manager"
    printf '%b' "$C_RESET"
    printf '%b' "$C_DIM$C_GRAY"
    printf '%s\n' "  Model Runtime & Backend Control"
    printf '%b' "$C_RESET"
    printf '%b' "$C_DIM$C_GRAY"
    sep "$cols"
    printf '%b' "$C_RESET"
}

process_start() {
    local stat
    [[ "$1" =~ ^[1-9][0-9]*$ ]] || return 1
    stat=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
    stat="${stat##*) }"
    [[ "$stat" != Z\ * ]] || return 1
    awk '{print $20}' <<< "$stat"
}

server_pid() {
    if [ -f "$PIDFILE" ]; then
        local pid
        pid=$(cat "$PIDFILE" 2>/dev/null || true)

        # Verify process identity as well as PID to avoid PID-reuse kills.
        local recorded actual
        [ "$(cat "$PIDFILE.boot" 2>/dev/null)" = "$(cat /proc/sys/kernel/random/boot_id)" ] || return 1
        recorded=$(cat "$PIDFILE.start" 2>/dev/null || true)
        actual=$(process_start "$pid")
        if [[ "$pid" =~ ^[1-9][0-9]*$ ]] && [ -n "$recorded" ] && [ "$recorded" = "$actual" ] && kill -0 "$pid" 2>/dev/null; then
            echo "$pid"
            return 0
        fi
    fi

    return 1
}

server_health() {
    curl --noproxy '*' -fsS \
        --max-time 1 \
        "$(api_base)/health" \
        >/dev/null 2>&1
}

# ─────────────────────────────────────────────
# API readiness: base URL, reachability, running model ID.
# ─────────────────────────────────────────────

# Query /v1/models and print exactly one line: the running model id,
# "unavailable" when the API did not answer, or "malformed" when the
# HTTP body is not a usable JSON model list. A saved runtime endpoint is used
# only when its PID/start/boot identity is valid. When a loaded model is known,
# prefer an exact or basename ID match; otherwise use the first listed ID as a
# documented fallback.
# Exit: 0 for id, 1 for unavailable, 2 for malformed.
api_models_info() {
    local body expected_id="" model_id
    if server_pid >/dev/null && [ -f "$STATE_DIR/runtime.env" ]; then
        # shellcheck disable=SC1091
        source "$STATE_DIR/runtime.env"
        expected_id=$(basename "${RUN_MODEL:-}" 2>/dev/null || true)
        [ "$expected_id" = "." ] && expected_id=""
    fi
    if body=$(curl --noproxy '*' --max-time 5 -f -sS \
            --connect-timeout 3 \
            "$(api_base)/v1/models" 2>/dev/null); then
        if [ -n "$expected_id" ]; then
            model_id=$(jq -er --arg expected "$expected_id" '
                ([.data[]?.id // empty] |
                 map(select(. == $expected or (split("/")[-1] == $expected)))[0] // empty)
            ' <<< "$body" 2>/dev/null || true)
            if [ -z "$model_id" ]; then
                printf '%s\n' "malformed"
                return 2
            fi
        else
            model_id=$(jq -er '.data[0].id // empty' <<< "$body" 2>/dev/null || true)
        fi
        if [ -n "$model_id" ]; then
            printf '%s\n' "$model_id"
            return 0
        fi
        printf '%s\n' "malformed"
        return 2
    fi
    printf '%s\n' "unavailable"
    return 1
}

choose_model() {
    local selected models
    models=$(scan_models) || { pause; return 1; }
    [ -n "$models" ] || { echo "No models found in $MODEL_ROOT. Set Model directory in settings." >&2; pause; return 1; }

    selected=$(
        printf '%s\n' "$models" \
        | gum filter \
            --height 20 \
            --placeholder "Search model..."
    )

    [ -n "$selected" ] || return 1

    # Preserve the previous model's last-used parameters.
    # Only save when switching to a DIFFERENT model — re-selecting the same model
    # must NOT overwrite its own profile with the current in-memory values.
    if [ -n "$CURRENT_MODEL" ] &&
       [ "$selected" != "$CURRENT_MODEL" ] &&
       { [ -f "$CURRENT_MODEL" ] || [ -d "$CURRENT_MODEL" ]; }; then
        save_model_profile
    fi

    CURRENT_MODEL="$selected"
    model_info "$CURRENT_MODEL"
    gpu_info
    pause

    # Each model gets its own remembered settings.
    load_model_profile
    save_config
}

find_mmproj() {
    if [ -n "$MMPROJ_PATH" ]; then
        [ -r "$MMPROJ_PATH" ] && [ -f "$MMPROJ_PATH" ] || { echo "Projector not readable: $MMPROJ_PATH" >&2; return 1; }
        printf '%s\n' "$MMPROJ_PATH"
        return
    fi
    local -a projectors=()
    mapfile -d '' -t projectors < <(find "$(dirname "$CURRENT_MODEL")" -maxdepth 1 -type f -iname '*mmproj*.gguf' -print0)
    [ "${#projectors[@]}" -eq 1 ] || { echo "Vision requires exactly one adjacent mmproj or an explicit projector path (found ${#projectors[@]})." >&2; return 1; }
    printf '%s\n' "${projectors[0]}"
}

with_lifecycle_lock() (
    flock -n 9 || { echo "Another manager is changing the server; retry shortly." >&2; return 1; }
    "$@"
) 9>"$STATE_DIR/lifecycle.lock"

stop_server() { with_lifecycle_lock stop_server_locked; }

stop_server_locked() {
    local pid
    if ! pid=$(server_pid); then
        echo "No verified managed process to stop; external services are untouched."
        return 0
    fi
    echo "Stopping managed server PID $pid..."
    # Recheck identity before each signal, including escalation.
    [ "$(server_pid)" = "$pid" ] || return 1
    kill -TERM "$pid" 2>/dev/null || true
    for _ in {1..40}; do
        server_pid >/dev/null || break
        sleep 0.1
    done
    if [ "$(server_pid)" = "$pid" ]; then
        echo "Graceful shutdown timed out; stopping the verified managed process."
        kill -KILL "$pid" 2>/dev/null || true
        for _ in {1..20}; do
            server_pid >/dev/null || break
            sleep 0.1
        done
    fi
    server_pid >/dev/null && { echo "Unable to stop managed process." >&2; return 1; }
    wait "$pid" 2>/dev/null || true
    rm -f "$PIDFILE" "$PIDFILE.start" "$PIDFILE.boot" "$STATE_DIR/runtime.env"
    echo "Stopped."
}

start_server() { with_lifecycle_lock start_server_locked; }

start_server_locked() {
    server_pid >/dev/null && { echo "Managed process already exists; use Load / Switch Model." >&2; return 1; }
    preflight || return 1

    # Interactive port conflict resolution
    if ! port_available 2>/dev/null; then
        echo ""
        echo "Port $PORT is already in use."
        echo ""
        if [ -t 0 ] && [ -t 1 ]; then
            local port_choice
            port_choice=$(printf 'Choose a different port\nCancel\n' | gum choose || echo "Cancel")
            case "$port_choice" in
                "Choose a different port")
                    local new_port
                    new_port=$(gum input --value="8000" --placeholder "Enter an available port number")
                    if [ -z "$new_port" ] || ! [[ "$new_port" =~ ^[0-9]+$ ]]; then
                        echo "Invalid port." >&2; pause; return 1
                    fi
                    PORT="$new_port"
                    # Re-check
                    port_available || { echo "Port $PORT also in use." >&2; pause; return 1; }
                    ;;
                *) echo "Cancelled."; return 1 ;;
            esac
        else
            echo "Non-interactive: choose a different port or set PORT in settings." >&2
            return 1
        fi
    fi

    : > "$LOGFILE"
    echo "Loading $(basename "$CURRENT_MODEL") on $HOST:$PORT (timeout ${STARTUP_TIMEOUT}s)..."
    echo "Server startup: $(date)" >> "$LOGFILE"
    local effective_backend
    effective_backend=$(resolve_backend "$CURRENT_MODEL")
    echo "Backend: $effective_backend" >> "$LOGFILE"
    local effective_plugin
    effective_plugin=$(resolve_plugin "$CURRENT_MODEL")
    echo "Plugin: $effective_plugin" >> "$LOGFILE"

    if [ "$effective_backend" = "vLLM" ]; then
        # vLLM startup needs longer due to CUDA graph compilation
        local orig_timeout="$STARTUP_TIMEOUT"
        [ "$orig_timeout" -lt 300 ] && STARTUP_TIMEOUT=300
        echo "Note: vLLM first start compiles CUDA kernels, may take 5+ minutes."
    fi

    nohup "${SERVER_ARGS[@]}" 9>&- >"$LOGFILE" 2>&1 < /dev/null &
    local pid=$! deadline=$((SECONDS + STARTUP_TIMEOUT))
    echo "$pid" > "$PIDFILE"
    process_start "$pid" > "$PIDFILE.start" || true
    cat /proc/sys/kernel/random/boot_id > "$PIDFILE.boot"
    {
        printf 'RUN_MODEL=%q\n' "$CURRENT_MODEL"
        printf 'RUN_HOST=%q\n' "$HOST"
        printf 'RUN_PORT=%q\n' "$PORT"
    } > "$STATE_DIR/runtime.env"
    trap 'stop_server_locked; exit 130' INT TERM
    while (( SECONDS < deadline )); do
        if ! server_pid >/dev/null; then
            local backend_name
            backend_name=$(resolve_backend "$CURRENT_MODEL")
            echo "${backend_name} server exited before becoming ready. Check backend/model compatibility." >&2
            echo "Server log: $LOGFILE" >&2
            tail -20 "$LOGFILE" >&2
            wait "$pid" 2>/dev/null || true
            rm -f "$PIDFILE" "$PIDFILE.start" "$PIDFILE.boot" "$STATE_DIR/runtime.env"
            return 1
        fi
        if server_health && server_pid >/dev/null; then
            trap - INT TERM
            echo "Model ready: $(api_base)/v1"
            return 0
        fi
        sleep 0.25
    done
    echo "Startup timed out; cleaning up this launch. Log: $LOGFILE" >&2
    tail -20 "$LOGFILE" >&2
    stop_server_locked || true
    return 1
}

report_action() {
    local label="$1" report result=0
    shift
    report=$(mktemp "$STATE_DIR/action.XXXXXX") || return 1
    echo "$label..."
    "$@" > "$report" 2>&1 || result=$?
    if [ "$result" -eq 0 ]; then
        LAST_ACTION="$label succeeded."
    else
        LAST_ACTION="$label failed (exit $result):"$'\n'"$(cat "$report")"
    fi
    cat "$report"
    rm -f -- "$report"
    printf '%s\n' "$LAST_ACTION"
    return "$result"
}

switch_model() {
    LAST_ACTION="Model selection cancelled; no model was stopped."
    choose_model || return 1
    LAST_ACTION="Loading cancelled in settings; selected model is not necessarily running."
    settings_menu load || return 1

    # Ensure the required backend is installed
    local effective_backend
    effective_backend=$(resolve_backend "$CURRENT_MODEL")
    LAST_ACTION="Backend installation"
    if [ "$effective_backend" = "vLLM" ]; then
        ensure_backend "vllm" || { pause; return 1; }
    elif [ "$effective_backend" = "llama.cpp" ]; then
        ensure_backend "llama.cpp" || { pause; return 1; }
    fi

    # For Mirai packages: ensure NVIDIA runtime payload is present
    if is_mirai_package "$CURRENT_MODEL" 2>/dev/null; then
        LAST_ACTION="Runtime payload download"
        ensure_mirai_payload || { pause; return 1; }
    fi

    # Install plugin if needed
    local effective_plugin
    effective_plugin=$(resolve_plugin "$CURRENT_MODEL")
    if [ "$effective_plugin" = "Mirai S" ]; then
        LAST_ACTION="Plugin installation"
        ensure_plugin "$effective_plugin" || { pause; return 1; }
    fi

    # Persist resolved values
    if [ -z "$BACKEND" ]; then
        BACKEND=$effective_backend
    fi
    if [ -z "$PLUGIN" ]; then
        PLUGIN=$effective_plugin
    fi
    [ -n "$CURRENT_MODEL" ] && save_model_profile
    save_config

    report_action "Validation" preflight || { pause; return 1; }
    local expected_pid
    expected_pid=$(server_pid || true)
    if [ -n "$expected_pid" ]; then
        LAST_ACTION="Switch cancelled; the managed model was kept running."
        gum confirm "Stop the managed model and load $(basename "$CURRENT_MODEL")?" || return 1
    fi
    local result=0
    report_action "Model loading" with_lifecycle_lock switch_server_locked "$expected_pid" || result=$?
    pause
    return "$result"
}

switch_server_locked() {
    [ "$(server_pid || true)" = "${1:-}" ] || { echo "Managed process changed; select Load / Switch again." >&2; return 1; }
    # Validate again under the lock before touching a working model.
    preflight || return 1
    local RUN_HOST="$HOST" RUN_PORT="$PORT" RUN_MODEL=""
    if server_pid >/dev/null; then
        if [ -f "$STATE_DIR/runtime.env" ]; then
            # shellcheck disable=SC1091
            source "$STATE_DIR/runtime.env"
        fi
        if [ "$HOST:$PORT" != "$RUN_HOST:$RUN_PORT" ]; then port_available || return 1; fi
        stop_server_locked || return 1
    fi
    start_server_locked
}

# ─────────────────────────────────────────────
# Colored status screen
# ─────────────────────────────────────────────

status_screen() {
    title

    local status
    status=$(runtime_status)

    # ── Server panel ──
    printf '%b' "$C_DIM$C_GRAY"
    sep
    printf '%b' "$C_RESET"
    printf '  %-15s ' "Server"
    colored_status "$status"
    printf '\n'

    if server_pid >/dev/null && [ -f "$STATE_DIR/runtime.env" ]; then
        local RUN_MODEL="" RUN_HOST="" RUN_PORT=""
        # shellcheck disable=SC1091
        source "$STATE_DIR/runtime.env"
        printf '  %-15s %b%s%b\n' "Loaded model" "$C_CYAN" "$(basename "$RUN_MODEL")" "$C_RESET"
        printf '  %-15s %s\n' "PID" "$(server_pid)"
        printf '  %-15s %s\n' "API endpoint" "$(api_base)/v1"
    fi

    echo
    printf '%b' "$C_DIM$C_GRAY"
    sep
    printf '%b' "$C_RESET"
    printf '  %-15s ' "API reachable"
    api_ready_lines
    echo

    # ── Profile panel ──
    printf '%b' "$C_DIM$C_GRAY"
    sep
    printf '%b' "  $C_BOLD$C_WHITE"
    printf '%s\n' "Model Profile"
    printf '%b' "$C_RESET"
    local model_label="${CURRENT_MODEL:+$(basename "$CURRENT_MODEL")}"
    printf '  %-17s ' "Model"
    printf '%b%s%b\n' "$C_CYAN" "${model_label:-None}" "$C_RESET"

    local effective_backend effective_plugin
    effective_backend=$(resolve_backend "$CURRENT_MODEL")
    effective_plugin=$(resolve_plugin "$CURRENT_MODEL")
    printf '  %-17s %s\n' "Backend" "$effective_backend"
    if [ -n "$effective_plugin" ] && [ "$effective_plugin" != "None" ]; then
        printf '  %-17s %s\n' "Plugin" "$effective_plugin"
    fi

    # ── llama.cpp profile ──
    if [ "$effective_backend" = "llama.cpp" ]; then
        printf '  %-17s %s\n' "Context" "$CTX"
        printf '  %-17s %s\n' "GPU layers" "$NGL"
        printf '  %-17s %s\n' "Flash Attention" "$FLASH"
        printf '  %-17s %s\n' "Batch / UBatch" "$BATCH / $UBATCH"
        printf '  %-17s %s\n' "Parallel" "$PARALLEL"
        printf '  %-17s %s\n' "KV cache K/V" "$CACHE_K / $CACHE_V"

    # ── vLLM profile ──
    elif [ "$effective_backend" = "vLLM" ]; then
        printf '  %-17s %s\n' "GPU memory util" "$VLLM_GPU_MEMORY_UTIL"
        printf '  %-17s %s\n' "Max model len" "$VLLM_MAX_MODEL_LEN"
        printf '  %-17s %s\n' "Max num seqs" "$VLLM_MAX_NUM_SEQS"
        printf '  %-17s %s\n' "Max batched tokens" "$VLLM_MAX_BATCHED_TOKENS"
        if [ "$effective_plugin" = "Mirai S" ]; then
            printf '  %-17s %s\n' "MTP" "$MTP"
        fi
    fi

    printf '  %-17s %s\n' "Temperature" "$TEMP"
    printf '  %-17s %s\n' "Top-P / Top-K" "$TOP_P / $TOP_K"
    printf '  %-17s %s\n' "Min-P" "$MIN_P"
    printf '  %-17s ' "Reasoning budget"
    if [ "$REASONING_BUDGET" = -1 ]; then
        printf '%b%s%b' "$C_GRAY" "Unlimited" "$C_RESET"
    elif [ "$REASONING_BUDGET" = 0 ]; then
        printf '%b%s%b' "$C_YELLOW" "Disabled (0)" "$C_RESET"
    else
        printf '%s' "$REASONING_BUDGET"
    fi
    printf '\n'
    printf '  %-17s ' "Max output tokens"
    if [ "$MAX_OUTPUT_TOKENS" = -1 ]; then
        printf '%b%s%b' "$C_GRAY" "Unlimited" "$C_RESET"
    else
        printf '%s' "$MAX_OUTPUT_TOKENS"
    fi
    printf '\n'

    if [ "$effective_backend" = "llama.cpp" ]; then
        local vision_label="${MMPROJ_PATH:-auto or adjacent projector}"
        printf '  %-17s %s (%s)\n' "Vision" "$VISION" "$vision_label"
        printf '  %-17s %s (%s, draft max %s)\n' "MTP" "$MTP" "$MTP_MODE" "$MTP_DRAFT_MAX"
        lora_label="off"
        [ "$LORA_ENABLED" = "on" ] && lora_label="Uncensored x$LORA_SCALE"
        printf '  %-17s %b%s%b\n' "LoRA" "$C_MAGENTA" "$lora_label" "$C_RESET"
    fi

    # ── GPU panel ──
    echo
    printf '%b' "$C_DIM$C_GRAY"
    sep
    printf '%b' "  $C_BOLD$C_WHITE"
    printf '%s\n' "GPU & Memory"
    printf '%b' "$C_RESET"
    memory_status

    pause
}

# ─────────────────────────────────────────────
# API Ready view
# ─────────────────────────────────────────────

# Emit the API-Ready facts as aligned lines and return a readiness status.
# Suitable for stdout, the Status screen, and the API Ready view; nothing
# interactive.  The Status/TUI callers ignore the status, while the CLI uses it
# for automation-friendly nonzero failures.
api_ready_status() {
    local base health_status=0 model_status=0 model_id
    base="$(api_base)"
    printf 'API base URL  : %s\n' "$base"
    printf 'OpenAI API    : %s/v1\n' "$base"
    if server_health; then
        printf 'API reachable : yes\n'
    else
        health_status=$?
        # curl normally returns 1 here, but preserve any nonzero health code
        # when a test double or platform curl reports something more specific.
        [ "$health_status" -ne 0 ] || health_status=1
        printf 'API reachable : no\n'
    fi

    if model_id=$(api_models_info); then
        model_status=0
    else
        model_status=$?
    fi
    case "$model_id" in
        "unavailable")
            printf 'Model ID      : unavailable (API not responding)\n'
            ;;
        "malformed")
            printf 'Model ID      : not reported (unexpected API response)\n'
            ;;
        "")
            printf 'Model ID      : unknown\n'
            ;;
        *)
            printf 'Model ID      : %s\n' "$model_id"
            ;;
    esac

    # A healthy /health response with an unusable model list is distinct from
    # transport/API failure, matching api_models_info()'s 0/1/2 contract.
    if [ "$health_status" -ne 0 ]; then
        return 1
    fi
    return "$model_status"
}

# Display-only compatibility wrapper: status screens must remain interactive
# and must not terminate because an external API is unavailable.
api_ready_lines() {
    api_ready_status || true
}

# Interactive API Ready view.
api_ready_view() {
    title

    printf '%b' "$C_DIM$C_GRAY"
    sep
    printf '%b' "  $C_BOLD$C_WHITE"
    printf '%s\n' "API Ready"
    printf '%b' "$C_RESET"

    local health_color="$C_GREEN" health_text="yes"
    if ! server_health; then
        health_color="$C_RED"
        health_text="no"
    fi
    local base
    base="$(api_base)"
    printf '  %-17s %s\n' "API base URL" "$base"
    printf '  %-17s %s\n' "OpenAI API" "$base/v1"
    printf '  %-17s ' "API reachable"
    printf '%b%s%b\n' "$health_color$C_BOLD" "$health_text" "$C_RESET"

    local model_id="unknown"
    model_id=$(api_models_info || true)
    case "$model_id" in
        "unavailable") model_id="unavailable (API not responding)" ;;
        "malformed")   model_id="not reported (unexpected API response)" ;;
    esac
    printf '  %-17s %s\n' "Model ID" "$model_id"

    echo
    printf '%b' "$C_DIM$C_GRAY"
    sep
    printf '%b' "$C_RESET"
    echo "  Connect an external OpenAI-compatible client (DSH, Hermes,"
    echo "  OpenCode, Pi, ...):"
    echo "    base_url -> set to the OpenAI API line above (including /v1 suffix)"
    echo "    model    -> set to the Model ID line above (as reported by /v1/models,"
    echo "                not the file name)"
    echo "    api_key  -> not required (local server, no authentication)"
    pause
}

# ─────────────────────────────────────────────
# Settings menu (colored)
# ─────────────────────────────────────────────

settings_menu() {
    local mode="${1:-edit}"

    while true; do
        title

        local model_name="${CURRENT_MODEL:+$(basename "$CURRENT_MODEL")}"
        if [ -n "$model_name" ]; then
            printf '  %bModel%b : %b%s%b\n' "$C_DIM" "$C_RESET" "$C_CYAN" "$model_name" "$C_RESET"
        fi
        # Show detected format
        local format_name format_str
        format_name=$(model_format_key "$CURRENT_MODEL" "format" 2>/dev/null || echo "unknown")
        case "$format_name" in
            gguf*|gguf_shard) format_str="GGUF" ;;
            hf) format_str="HuggingFace" ;;
            mirai_s) format_str="Mirai S" ;;
            *) format_str="$format_name" ;;
        esac
        if [ -n "$format_str" ] && [ "$format_str" != "unknown" ]; then
            printf '  %bFormat%b : %s\n' "$C_DIM" "$C_RESET" "$format_str"
        fi
        local effective_backend effective_plugin
        effective_backend=$(resolve_backend "$CURRENT_MODEL")
        effective_plugin=$(resolve_plugin "$CURRENT_MODEL")
        printf '  %bBackend%b         %s\n' "$C_DIM" "$C_RESET" "$effective_backend"
        printf '  %bPlugin%b          %s\n' "$C_DIM" "$C_RESET" "$effective_plugin"
        local backend_label="$SERVER_BIN"
        [ -n "${PMM_SERVER_BIN:-}" ] && backend_label="$backend_label (PMM_SERVER_BIN)"
        printf '%b' "$C_DIM$C_GRAY"
        sep
        printf '%b' "$C_RESET"
        echo

        local -a items=(
            # Backend / Plugin selection
            "Backend               [$(resolve_backend "$CURRENT_MODEL")]"
            "Plugin                [$(resolve_plugin "$CURRENT_MODEL")]"
        )

        # ── llama.cpp settings ──
        if [ "$effective_backend" = "llama.cpp" ]; then
            items+=(
                "Context size          [$CTX]"
                "GPU layers            [$NGL]"
                "Flash Attention       [$FLASH]"
                "Batch size            [$BATCH]"
                "UBatch size           [$UBATCH]"
                "Parallel slots        [$PARALLEL]"
                "KV cache K            [$CACHE_K]"
                "KV cache V            [$CACHE_V]"
                "Temperature           [$TEMP]"
                "Top-P                 [$TOP_P]"
                "Top-K                 [$TOP_K]"
                "Min-P                 [$MIN_P]"
                "Reasoning budget      [$REASONING_BUDGET]"
                "Max output tokens     [$MAX_OUTPUT_TOKENS]"
                "Vision                [$VISION]"
                "Projector path        [${MMPROJ_PATH:-auto}]"
                "MTP                   [$MTP]"
                "MTP mode              [$MTP_MODE]"
                "MTP draft flag        [$MTP_DRAFT_FLAG]"
                "MTP draft max         [$MTP_DRAFT_MAX]"
                "Backend executable    [$SERVER_BIN]"
                "Uncensored LoRA       [$LORA_ENABLED]"
                "LoRA scale            [$LORA_SCALE]"
                "LoRA file             [$(basename "$LORA_PATH")]"
                "API host              [$HOST]"
                "API port              [$PORT]"
                "Startup timeout       [$STARTUP_TIMEOUT]"
            )

        # ── vLLM settings ──
        elif [ "$effective_backend" = "vLLM" ]; then
            items+=(
                "GPU memory util       [$VLLM_GPU_MEMORY_UTIL]"
                "Max model len         [$VLLM_MAX_MODEL_LEN]"
                "Max num sequences     [$VLLM_MAX_NUM_SEQS]"
                "Max batched tokens    [$VLLM_MAX_BATCHED_TOKENS]"
                "Temperature           [$TEMP]"
                "Top-P                 [$TOP_P]"
                "Top-K                 [$TOP_K]"
                "Min-P                 [$MIN_P]"
                "Reasoning budget      [$REASONING_BUDGET]"
                "Max output tokens     [$MAX_OUTPUT_TOKENS]"
                "API host              [$HOST]"
                "API port              [$PORT]"
                "Startup timeout       [$STARTUP_TIMEOUT]"
            )
            if [ "$effective_plugin" = "Mirai S" ]; then
                items+=(
                "MTP                   [$MTP]"
                )
            fi
        fi

        items+=(
            "Model root            [$MODEL_ROOT]"
        )

        if [ "$effective_backend" = "vLLM" ]; then
            items+=(
            "vLLM environment      [$VLLM_ROOT]"
            )
            if [ "$effective_plugin" = "Mirai S" ]; then
                items+=(
                "Plugin directory      [$(effective_plugin_dir "$CURRENT_MODEL" "$effective_plugin")]"
                )
            fi
        fi

        if [ "$mode" = "load" ]; then
            items+=("▶ Start with these settings")
        fi

        items+=("Back")

        local previous
        previous=$(declare -p HOST PORT STARTUP_TIMEOUT BACKEND PLUGIN PLUGIN_DIR MODEL_ROOT TEMP TOP_P TOP_K MIN_P REASONING_BUDGET MAX_OUTPUT_TOKENS)
        if [ "$effective_backend" = "llama.cpp" ]; then
            previous="$previous"$'\n'"$(declare -p CTX NGL FLASH BATCH UBATCH PARALLEL CACHE_K CACHE_V VISION MMPROJ_PATH MTP MTP_MODE MTP_DRAFT_MAX MTP_DRAFT_FLAG SERVER_BIN LORA_ENABLED LORA_SCALE LORA_PATH)"
        fi
        if [ "$effective_backend" = "vLLM" ]; then
            previous="$previous"$'\n'"$(declare -p VLLM_GPU_MEMORY_UTIL VLLM_MAX_MODEL_LEN VLLM_MAX_NUM_SEQS VLLM_MAX_BATCHED_TOKENS)"
            # Also save MTP if Mirai S (for vLLM's benefit)
            if [ "$effective_plugin" = "Mirai S" ]; then
                previous="$previous"$'\n'"$(declare -p MTP)"
            fi
        fi
        local choice
        choice=$(printf '%s
' "${items[@]}" | gum choose --height 22)

        case "$choice" in

            "Backend"*)
                local value
                value=$(printf 'llama.cpp\nvLLM\n' | gum choose || true)
                [ -n "$value" ] && BACKEND="$value"
                # Persist immediately
                [ -n "$CURRENT_MODEL" ] && save_model_profile
                save_config
                ;;

            "Plugin"*)
                local value
                value=$(printf 'None\nMirai S\n' | gum choose || true)
                [ -n "$value" ] && PLUGIN="$value"
                # Persist immediately
                [ -n "$CURRENT_MODEL" ] && save_model_profile
                save_config
                ;;

            "Context size"*)
                CTX=$(gum input \
                    --value="$CTX" \
                    --placeholder "8192 / 16384 / 32768 / 65536")
                ;;

            "Max model len"*)
                VLLM_MAX_MODEL_LEN=$(gum input \
                    --value="$VLLM_MAX_MODEL_LEN" \
                    --placeholder "-1 = auto, or max sequence length")
                ;;

            "GPU layers"*)
                NGL=$(gum input \
                    --value="$NGL" \
                    --placeholder "99 = full GPU, 0 = CPU")
                ;;

            "Flash Attention"*)
                local value
                value=$(printf 'on
off
auto
' | gum choose || true)
                [ -n "$value" ] && FLASH="$value"
                ;;

            "Batch size"*)
                BATCH=$(gum input --value="$BATCH")
                ;;

            "UBatch size"*)
                UBATCH=$(gum input --value="$UBATCH")
                ;;

            "Parallel slots"*)
                PARALLEL=$(gum input --value="$PARALLEL")
                ;;

            "KV cache K"*)
                local value
                value=$(printf 'f16
bf16
f32
q8_0
q4_0
q4_1
q5_0
q5_1
iq4_nl
' | gum choose || true)
                [ -n "$value" ] && CACHE_K="$value"
                ;;

            "KV cache V"*)
                local value
                value=$(printf 'f16
bf16
f32
q8_0
q4_0
q4_1
q5_0
q5_1
iq4_nl
' | gum choose || true)
                [ -n "$value" ] && CACHE_V="$value"
                ;;

            "Temperature"*)
                TEMP=$(gum input --value="$TEMP")
                ;;

            "Top-P"*)
                TOP_P=$(gum input --value="$TOP_P")
                ;;

            "Top-K"*)
                TOP_K=$(gum input --value="$TOP_K")
                ;;

            "Min-P"*)
                MIN_P=$(gum input --value="$MIN_P")
                ;;

            "Reasoning budget"*)
                REASONING_BUDGET=$(gum input \
                    --value="$REASONING_BUDGET" \
                    --placeholder="-1 unlimited, 0 disabled, e.g. 4096")
                ;;

            "Max output tokens"*)
                MAX_OUTPUT_TOKENS=$(gum input \
                    --value="$MAX_OUTPUT_TOKENS" \
                    --placeholder="-1 = unlimited, or a positive token budget, e.g. 4096")
                ;;

            "Vision"*)
                local value
                value=$(printf 'off
on
' | gum choose || true)
                [ -n "$value" ] && VISION="$value"
                ;;

            "Projector path"*) MMPROJ_PATH=$(gum input --value="$MMPROJ_PATH" --placeholder "Empty: one adjacent mmproj") ;;
            "MTP mode"*) MTP_MODE=$(printf 'mtp\ndraft-mtp\n' | gum choose) ;;
            "MTP draft flag"*) MTP_DRAFT_FLAG=$(printf '%s\n' --spec-draft-n-max --draft-max | gum choose) ;;
            "MTP draft max"*) MTP_DRAFT_MAX=$(gum input --value="$MTP_DRAFT_MAX") ;;
            "MTP"*) MTP=$(printf 'off\non\n' | gum choose) ;;
            "Backend executable"*)
                if [ -n "${PMM_SERVER_BIN:-}" ]; then
                    echo "PMM_SERVER_BIN controls this session. Unset it before editing the backend path."
                    pause
                    continue
                fi
                local value
                value=$(gum input --value="$SERVER_BIN" --placeholder "/path/to/custom/llama-server") || continue
                if [ -z "$value" ] || [ ! -f "$value" ] || [ ! -x "$value" ]; then
                    echo "Keep the previous backend: choose a nonempty executable file path." >&2
                    pause
                    continue
                fi
                SERVER_BIN="$value"
                ;;
            "API host"*) HOST=$(gum input --value="$HOST") ;;
            "API port"*) PORT=$(gum input --value="$PORT") ;;
            "Startup timeout"*) STARTUP_TIMEOUT=$(gum input --value="$STARTUP_TIMEOUT") ;;

            "Uncensored LoRA"*)
                local value
                value=$(printf 'off
on
' | gum choose || true)
                [ -n "$value" ] && LORA_ENABLED="$value"
                ;;

            "LoRA scale"*)
                LORA_SCALE=$(gum input \
                    --value="$LORA_SCALE" \
                    --placeholder "2")
                ;;

            "LoRA file"*)
                LORA_PATH=$(gum input \
                    --value="$LORA_PATH" \
                    --placeholder "/path/to/adapter.gguf")
                ;;

            "vLLM environment"*)
                VLLM_ROOT=$(gum input \
                    --value="$VLLM_ROOT" \
                    --placeholder "~/.local/share/prism-model-manager/backends/vllm-venv")
                ;;

            "GPU memory util"*)
                VLLM_GPU_MEMORY_UTIL=$(gum input \
                    --value="$VLLM_GPU_MEMORY_UTIL" \
                    --placeholder "0.90 = fraction of GPU memory")
                ;;

            "Max num sequences"*)
                VLLM_MAX_NUM_SEQS=$(gum input \
                    --value="$VLLM_MAX_NUM_SEQS" \
                    --placeholder "16")
                ;;

            "Max batched tokens"*)
                VLLM_MAX_BATCHED_TOKENS=$(gum input \
                    --value="$VLLM_MAX_BATCHED_TOKENS" \
                    --placeholder "2048")
                ;;

            "Plugin directory"*)
                PLUGIN_DIR=$(gum input \
                    --value="$(effective_plugin_dir "$CURRENT_MODEL" "$effective_plugin")" \
                    --placeholder "Custom path, or empty for default")
                ;;

            "Model root"*)
                MODEL_ROOT=$(gum input --value="$MODEL_ROOT")
                ;;

            "▶ Start with these settings")
                validate_settings || { pause; continue; }
                save_model_profile
                save_config
                return 0
                ;;

            "Back"|"")
                save_model_profile
                save_config
                [ -n "$CURRENT_MODEL" ] || capture_runtime_defaults

                if [ "$mode" = "load" ]; then
                    return 1
                fi

                return 0
                ;;
        esac

        if ! validate_settings; then
            # Values originate only from Bash declare -p above, never raw input.
            eval "${previous//declare --/declare -g --}"
            pause
            continue
        fi
        save_model_profile
        save_config
    done
}

quick_test() {
    title

    if ! server_health; then
        printf '%bServer is not running.%b\n' "$C_YELLOW$C_BOLD" "$C_RESET"
        pause
        return
    fi

    local prompt
    prompt=$(gum write \
        --width 80 \
        --height 5 \
        --placeholder "Ask the loaded model something...")

    [ -n "$prompt" ] || return

    local payload api_model
    api_model=$(curl --noproxy '*' -fsS --max-time 5 "$(api_base)/v1/models" | jq -er '.data[0].id') || {
        echo "Unable to identify the loaded API model." >&2; pause; return 1;
    }

    payload=$(jq -n \
        --arg prompt "$prompt" \
        --arg model "$api_model" \
        '{
            model: $model,
            messages: [
                {
                    role: "user",
                    content: $prompt
                }
            ],
            max_tokens: 1024
        }'
    )

    echo
    curl --noproxy '*' --connect-timeout 5 --max-time 300 --fail-with-body -sS \
        "$(api_base)/v1/chat/completions" \
        -H 'Content-Type: application/json' \
        -d "$payload" \
        | jq -r '
            .error.message // empty,
            .choices[0].message.reasoning_content // empty,
            .choices[0].message.content // empty,
            "",
            "── Performance ──",
            "Prompt: \(.timings.prompt_per_second // 0) tok/s",
            "Decode: \(.timings.predicted_per_second // 0) tok/s",
            "Tokens: \(.usage.total_tokens // 0)"
        ' || { echo 'Chat request failed; check server logs.' >&2; pause; return 1; }

    pause
}

show_vram() {
    memory_status
    pause
}

show_logs() {
    if [ -f "$LOGFILE" ]; then
        less +F "$LOGFILE"
    else
        echo "No server log yet."
        pause
    fi
}

open_webui() {
    if ! server_health; then
        printf '%bServer is not running.%b\n' "$C_YELLOW$C_BOLD" "$C_RESET"
        pause
        return
    fi

    xdg-open "$(api_base)" >/dev/null 2>&1 &
}

raw_benchmark() {
    title

    if server_pid >/dev/null || server_health; then
        echo "Stop the loaded model first."
        pause
        return
    fi

    [ -x "$BENCH_BIN" ] && [ -f "$CURRENT_MODEL" ] || { echo "Benchmark binary or model missing."; pause; return 1; }
    "$BENCH_BIN" \
        -m "$CURRENT_MODEL" \
        -ngl "$NGL" \
        -fa 1 \
        -p 512 \
        -n 128 \
        -r 3

    pause
}

lora_scale_benchmark() {
    title

    if server_pid >/dev/null || server_health; then
        echo "Stop the loaded model first."
        pause
        return
    fi

    load_model_profile

    local SCORE="$SCORE_BIN"
    local DIR
    DIR="$STATE_DIR/benchmarks/$(date +%Y%m%d-%H%M%S)"
    local PORT_AB="18080"
    (HOST=127.0.0.1 PORT="$PORT_AB"; port_available) || { pause; return 1; }

    mkdir -p "$DIR"

    [ -f "$CURRENT_MODEL" ] && [ -f "$LORA_PATH" ] && [ -f "$SCORE" ] && [ -x "$SERVER_BIN" ] || { echo "Configure model, LoRA, runtime and scoring helper first."; pause; return 1; }
    local SCALE PID READY
    local -a ARGS
    for SCALE in 0 1 1.5 2; do
        echo
        echo "===== Scale $SCALE ====="

        ARGS=(
            "$SERVER_BIN"
            -m "$CURRENT_MODEL"
            --host 127.0.0.1
            --port "$PORT_AB"
            -ngl "$NGL"
            -fa "$FLASH"
            -c "$CTX"
            -b "$BATCH"
            -ub "$UBATCH"
            -np 1
            --jinja
        )

        if [ "$SCALE" != "0" ]; then
            ARGS+=(--lora-scaled "$LORA_PATH:$SCALE")
        fi

        (HOST=127.0.0.1 PORT="$PORT_AB"; port_available) || return 1
        "${ARGS[@]}" >"$DIR/server-$SCALE.log" 2>&1 &
        PID=$!

        echo -n "Loading"

        READY=0
        for _ in {1..180}; do
            if kill -0 "$PID" 2>/dev/null && curl --noproxy '*' -fsS \
                --max-time 1 "http://127.0.0.1:$PORT_AB/health" \
                >/dev/null 2>&1
            then
                READY=1
                break
            fi

            if ! kill -0 "$PID" 2>/dev/null; then
                break
            fi

            printf "."
            sleep 0.5
        done

        echo

        if [ "$READY" -ne 1 ]; then
            echo "Scale $SCALE failed to load:"
            tail -40 "$DIR/server-$SCALE.log"
            kill "$PID" 2>/dev/null || true
            pause
            return
        fi

        python3 "$SCORE" run \
            --url "http://127.0.0.1:$PORT_AB" \
            --model "$CURRENT_MODEL" \
            --label "scale-$SCALE" \
            --out "$DIR/scale-$SCALE.json"

        kill -TERM "$PID" 2>/dev/null || true
        wait "$PID" 2>/dev/null || true
        sleep 1
    done

    python3 "$SCORE" summary --dir "$DIR"

    echo
    echo "Results: $DIR"
    pause
}

benchmark_model() {
    while true; do
        title

        CHOICE=$(printf '%s
' \
            "Raw Speed Benchmark" \
            "LoRA Scale Intelligence A/B" \
            "Back" \
            | gum choose --height 6)

        case "$CHOICE" in
            "Raw Speed Benchmark")
                raw_benchmark
                ;;
            "LoRA Scale Intelligence A/B")
                lora_scale_benchmark
                ;;
            "Back"|"")
                return
                ;;
        esac
    done
}

main_menu() {
    while true; do
        title

        local running
        running=$(runtime_status)

        # ── Model status panel ──
        local model_name="${CURRENT_MODEL:+$(basename "$CURRENT_MODEL")}"
        local effective_backend effective_plugin
        effective_backend=$(resolve_backend "$CURRENT_MODEL" 2>/dev/null || echo "Auto")
        effective_plugin=$(resolve_plugin "$CURRENT_MODEL" 2>/dev/null || echo "None")

        printf '  %b%s%b\n' "$C_DIM" "MODEL" "$C_RESET"
        printf '  %-14s ' "Status"
        colored_status "$running"
        printf '\n'
        if [ -n "$model_name" ]; then
            printf '  %-14s %b%s%b\n' "Name" "$C_CYAN" "$model_name" "$C_RESET"
        fi
        # Backend with install-state color
        local backend_color="$C_WHITE"
        case "$effective_backend" in
            "llama.cpp")
                if [ -x "$SERVER_BIN" ] || "$BACKEND_MANAGER" status llama.cpp 2>/dev/null | grep -q "installed:"; then
                    backend_color="$C_GREEN"
                else
                    backend_color="$C_YELLOW"
                fi
                ;;
            "vLLM")
                if "$BACKEND_MANAGER" status vllm 2>/dev/null | grep -q "installed:"; then
                    backend_color="$C_GREEN"
                else
                    backend_color="$C_YELLOW"
                fi
                ;;
        esac
        printf '  %-14s %b%s%b\n' "Backend" "$backend_color" "$effective_backend" "$C_RESET"

        # Plugin with color
        local plugin_color="$C_WHITE"
        case "$effective_plugin" in
            "Mirai S")
                if mirai_installed_for_model "$CURRENT_MODEL" 2>/dev/null; then
                    plugin_color="$C_MAGENTA"
                else
                    plugin_color="$C_YELLOW"
                fi
                ;;
            "None") plugin_color="$C_GRAY" ;;
        esac
        printf '  %-14s %b%s%b\n' "Plugin" "$plugin_color" "$effective_plugin" "$C_RESET"

        # Format
        local format_str
        format_str=$(model_format_key "$CURRENT_MODEL" "format" 2>/dev/null || echo "")
        case "$format_str" in
            gguf*|gguf_shard) format_str="GGUF" ;;
            hf) format_str="HF" ;;
            mirai_s) format_str="Mirai S" ;;
            *) format_str="" ;;
        esac
        [ -n "$format_str" ] && printf '  %-14s %s\n' "Format" "$format_str"

        if [ -n "$CURRENT_MODEL" ]; then
            printf '  %-14s %s\n' "Context" "$CTX"
            printf '  %-14s ' "Max tokens"
            if [ "$MAX_OUTPUT_TOKENS" = -1 ]; then
                printf '%b%s%b' "$C_GRAY" "Unlimited" "$C_RESET"
            else
                printf '%s' "$MAX_OUTPUT_TOKENS"
            fi
            printf '\n'
            printf '  %-14s ' "Reasoning"
            if [ "$REASONING_BUDGET" = -1 ]; then
                printf '%b%s%b' "$C_GRAY" "Unlimited" "$C_RESET"
            elif [ "$REASONING_BUDGET" = 0 ]; then
                printf '%b%s%b' "$C_YELLOW" "Disabled" "$C_RESET"
            else
                printf '%s' "$REASONING_BUDGET"
            fi
            printf '\n'
            printf '  %-14s %s\n' "MTP" "$MTP"
            printf '  %-14s %s\n' "Port" "$PORT"
        fi
        if [ -n "${LAST_ACTION:-}" ]; then
            local action_color="$C_GREEN"
            [[ "$LAST_ACTION" == *failed* ]] && action_color="$C_YELLOW"
            printf '%b' "$C_DIM$C_GRAY"
            sep
            printf '%b' "$C_RESET"
            printf '  %b%s%b\n' "$action_color$C_DIM" "$LAST_ACTION" "$C_RESET"
        fi

        printf '%b' "$C_DIM$C_GRAY"
        sep
        printf '%b' "$C_RESET"

        # Menu items with section labels
        local choice
        choice=$(printf '%s\n' \
            "▶ Load / Switch Model" \
            "⚙ Settings" \
            "● Status" \
            "💬 Quick Chat" \
            "🌐 Web UI" \
            "🔌 API Info" \
            "🔧 Backend Management" \
            "📊 GPU / RAM" \
            "⚡ Benchmark" \
            "📜 Logs" \
            "■ Stop Model" \
            "Exit" \
            | gum choose --height 15)

        case "$choice" in

            "▶ Load / Switch Model")
                switch_model
                ;;

            "⚙ Settings")
                if [ -n "$CURRENT_MODEL" ] && { [ -f "$CURRENT_MODEL" ] || [ -d "$CURRENT_MODEL" ]; }; then load_model_profile; fi
                settings_menu edit
                ;;

            "● Status")
                status_screen
                ;;

            "💬 Quick Chat")
                quick_test
                ;;

            "🌐 Web UI")
                open_webui
                ;;

            "🔌 API Info")
                api_ready_view
                ;;

            "🔧 Backend Management")
                title
                printf '%b' "$C_DIM$C_GRAY"
                sep
                printf '%b' "  $C_BOLD$C_WHITE"
                printf '%s\n' "Backend Management"
                printf '%b' "$C_RESET"
                echo ""
                if [ -x "$BACKEND_MANAGER" ]; then
                    "$BACKEND_MANAGER" status
                else
                    echo "Backend manager not found at: $BACKEND_MANAGER"
                fi
                echo ""
                local bchoice
                bchoice=$(printf '%s\n' \
                    "Install llama.cpp" \
                    "Install vLLM" \
                    "Install Mirai S Plugin" \
                    "Remove llama.cpp" \
                    "Remove vLLM" \
                    "Remove Mirai S Plugin" \
                    "Back" \
                    | gum choose --height 8)
                case "$bchoice" in
                    "Install llama.cpp")
                        "$BACKEND_MANAGER" install "llama.cpp" 2>&1
                        pause
                        ;;
                    "Install vLLM")
                        "$BACKEND_MANAGER" install "vllm" 2>&1
                        pause
                        ;;
                    "Install Mirai S Plugin")
                        "$BACKEND_MANAGER" install "mirai_s" 2>&1
                        pause
                        ;;
                    "Remove llama.cpp")
                        gum confirm "Remove llama.cpp backend?" && "$BACKEND_MANAGER" remove "llama.cpp" 2>&1
                        pause
                        ;;
                    "Remove vLLM")
                        gum confirm "Remove vLLM backend?" && "$BACKEND_MANAGER" remove "vllm" 2>&1
                        pause
                        ;;
                    "Remove Mirai S Plugin")
                        gum confirm "Remove Mirai S plugin?" && "$BACKEND_MANAGER" remove "mirai_s" 2>&1
                        pause
                        ;;
                esac
                ;;

            "📊 GPU / RAM")
                show_vram
                ;;

            "⚡ Benchmark")
                benchmark_model
                ;;

            "📜 Logs")
                show_logs
                ;;

            "■ Stop Model")
                if server_pid >/dev/null; then
                    gum confirm "Stop the managed model?" && stop_server
                else
                    echo "No managed model to stop."
                fi
                pause
                ;;

            "Exit"|"")
                exit 0
                ;;
        esac
    done
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    case "${1:-}" in
        --version) echo "$VERSION" ;;
        --help) echo "Usage: prism-model-manager [--scan|--gpu|--info MODEL|--dry-run MODEL|--logs|--check|--api-ready|--state|--clear-state|--backend-status|--backend-install llama.cpp|vllm|mirai_s|--version]" ;;
        --scan) scan_models ;;
        --gpu) gpu_info ;;
        --info) model_info "${2:?model path required}" ;;
        --dry-run)
            CURRENT_MODEL="${2:?model path required}"
            preflight || exit 1
            printf '%q ' "${SERVER_ARGS[@]}"; printf '\n' ;;
        --logs) show_logs ;;
        --check)
            [ -z "$CURRENT_MODEL" ] || load_model_profile
            preflight ;;
        --api-ready) api_ready_status ;;
        --state) runtime_state_status ;;
        --clear-state) clear_stale_state ;;
        --backend-status)
            if [ -x "$BACKEND_MANAGER" ]; then
                "$BACKEND_MANAGER" status
            else
                echo "Backend manager not found."
            fi ;;
        --backend-install)
            local b="${2:-}"
            [ -n "$b" ] || { echo "Usage: prism-model-manager --backend-install llama.cpp|vllm|mirai_s" >&2; exit 1; }
            if [ -x "$BACKEND_MANAGER" ]; then
                "$BACKEND_MANAGER" install "$b"
            else
                echo "Backend manager not found." >&2; exit 1
            fi ;;
        "")
            for dependency in gum curl jq less find sha256sum python3 flock timeout; do
                command -v "$dependency" >/dev/null || { echo "Missing dependency: $dependency" >&2; exit 1; }
            done
            save_config
            main_menu ;;
        *) echo "Unknown option: $1" >&2; exit 2 ;;
    esac
fi