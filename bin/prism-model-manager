#!/usr/bin/env bash

set -uo pipefail
umask 077
VERSION=4.0.0

# ── Color support ─────────────────────────────────
if [ -n "${NO_COLOR:-}" ] || ! [ -t 1 ]; then
    C_RESET=""
    C_BOLD=""
    C_DIM=""
    C_CYAN=""
    C_GREEN=""
    C_YELLOW=""
    C_RED=""
    C_MAGENTA=""
    C_GRAY=""
    C_BLUE=""
    C_WHITE=""
else
    # Detect truecolor support (COLORTERM=truecolor or 24-bit)
    if [[ "${COLORTERM:-}" =~ (truecolor|24bit) ]] || [[ "$TERM" == *-direct ]]; then
        C_RESET="\e[0m"
        C_BOLD="\e[1m"
        C_DIM="\e[2m"
        C_CYAN="\e[38;2;0;200;255m"
        C_GREEN="\e[38;2;0;220;130m"
        C_YELLOW="\e[38;2;255;200;50m"
        C_RED="\e[38;2;255;80;80m"
        C_MAGENTA="\e[38;2;200;100;255m"
        C_GRAY="\e[38;2;140;140;150m"
        C_BLUE="\e[38;2;80;160;255m"
        C_WHITE="\e[38;2;220;220;225m"
    else
        C_RESET="\e[0m"
        C_BOLD="\e[1m"
        C_DIM="\e[2m"
        C_CYAN="\e[36m"
        C_GREEN="\e[32m"
        C_YELLOW="\e[33m"
        C_RED="\e[31m"
        C_MAGENTA="\e[35m"
        C_GRAY="\e[90m"
        C_BLUE="\e[34m"
        C_WHITE="\e[97m"
    fi
fi

# ── Terminal width ────────────────────────────────
stty_output=$(stty size 2>/dev/null || true)
TERM_COLS="${stty_output##* }"
TERM_ROWS="${stty_output%% *}"
TERM_COLS="${TERM_COLS:-80}"
TERM_ROWS="${TERM_ROWS:-24}"

# ── Styled helpers ────────────────────────────────
style() {
    local color="$1" text="$2" bold=
    [ "${3:-}" = bold ] && bold="$C_BOLD"
    printf '%b%s%b' "$bold$color" "$text" "$C_RESET"
}

status_color() {
    local status="$1"
    case "$status" in
        *RUNNING*|*READY*|*succeeded*)   printf '%s' "$C_GREEN" ;;
        *LOADING*|*UNHEALTHY*)           printf '%s' "$C_CYAN" ;;
        *STOPPED*|*STALE*|*no\ healthy*) printf '%s' "$C_GRAY"  ;;
        *EXTERNAL*)                      printf '%s' "$C_YELLOW" ;;
        *WARNING*|*failed*)              printf '%s' "$C_YELLOW" ;;
        *ERROR*)                         printf '%s' "$C_RED" ;;
        *)                               printf '%s' "$C_WHITE" ;;
    esac
}

colored_status() {
    local status="$1"
    local color
    color=$(status_color "$status")
    printf '%b%s%b' "$color$C_BOLD" "$status" "$C_RESET"
}

sep() {
    local cols="${1:-$TERM_COLS}"

    # Ensure TERM_COLS is valid; fallback to 80
    cols="${cols:-80}"
    if ! [[ "$cols" =~ ^[0-9]+$ ]]; then cols=80; fi
    [ "$cols" -gt 120 ] && cols=120
    [ "$cols" -lt 8 ] && cols=80

    local character='-' line
    case "${LC_ALL:-${LC_CTYPE:-${LANG:-C}}}" in
        *[Uu][Tt][Ff]-8*|*[Uu][Tt][Ff]8*) character='━' ;;
    esac
    printf -v line '%*s' "$cols" ''
    printf '%s\n' "${line// /$character}"
}

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/prism-model-manager"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/prism-model-manager"
MODEL_PROFILE_DIR="$CONFIG_DIR/model-profiles"
CONFIG="$CONFIG_DIR/config.env"
PIDFILE="$STATE_DIR/server.pid"
LOGFILE="$STATE_DIR/server.log"

mkdir -p "$CONFIG_DIR" "$STATE_DIR" "$MODEL_PROFILE_DIR"

DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
BACKENDS_DIR="$DATA_HOME/prism-model-manager/backends"

# ─────────────────────────────────────────────
# Defaults
# ─────────────────────────────────────────────

MODEL_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/prism-model-manager/models"
PRISM_ROOT="${XDG_DATA_HOME:-$HOME/.local/share}/prism-llama"
SERVER_BIN=""
BENCH_BIN=""

