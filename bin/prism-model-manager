valid_model_len_scalar() {
    [[ "$1" == -1 || "$1" == auto || "$1" =~ ^[1-9][0-9]*$ ]]
}

# One input boundary for every editable scalar. Never commit failed/help output.
valid_input_value() {
    local name="$1" value="$2"
    [[ "$value" != *$'\n'* && "$value" != *$'\r'* &&
       "$value" != *'Usage:'* && "$value" != *'Prompt for some input'* &&
       "$value" != *'Flags:'* ]] || return 1
    case "$name" in
        REASONING_BUDGET|MAX_OUTPUT_TOKENS) [[ "$value" =~ ^-?[0-9]+$ ]] ;;
        *) return 0 ;;
    esac
}

edit_input() {
    local name="$1" value
    shift
    # gum renders its interactive UI on stderr; keep it attached to the terminal.
    if value=$(gum input "$@"); then
        if valid_input_value "$name" "$value"; then
            printf -v "$name" '%s' "$value"
        else
            printf 'Invalid %s. Previous value preserved.\n' "$name" >&2
            pause
        fi
    fi
    return 0
}

sanitize_settings() {
    return 0
}

# Config is trusted Bash, written with shell escaping. Never source untrusted files.
# shellcheck disable=SC1090
CONFIG_LOADED=0
CONFIG_HAS_MODEL_ROOT=0
CONFIG_HAS_PRISM_ROOT=0
CONFIG_HAS_SERVER_BIN=0
CONFIG_HAS_BENCH_BIN=0
CONFIG_HAS_MTP=0
CONFIG_HAS_MTP_MODE=0
CONFIG_HAS_MTP_DRAFT_MAX=0
if [ -f "$CONFIG" ]; then
    CONFIG_LOADED=1
    grep -Eq '^[[:space:]]*(export[[:space:]]+)?MODEL_ROOT[[:space:]]*=' "$CONFIG" && CONFIG_HAS_MODEL_ROOT=1
    grep -Eq '^[[:space:]]*(export[[:space:]]+)?PRISM_ROOT[[:space:]]*=' "$CONFIG" && CONFIG_HAS_PRISM_ROOT=1
    grep -Eq '^[[:space:]]*(export[[:space:]]+)?SERVER_BIN[[:space:]]*=' "$CONFIG" && CONFIG_HAS_SERVER_BIN=1
    grep -Eq '^[[:space:]]*(export[[:space:]]+)?BENCH_BIN[[:space:]]*=' "$CONFIG" && CONFIG_HAS_BENCH_BIN=1
    grep -Eq '^[[:space:]]*(export[[:space:]]+)?MTP[[:space:]]*=' "$CONFIG" && CONFIG_HAS_MTP=1
    grep -Eq '^[[:space:]]*(export[[:space:]]+)?MTP_MODE[[:space:]]*=' "$CONFIG" && CONFIG_HAS_MTP_MODE=1
    grep -Eq '^[[:space:]]*(export[[:space:]]+)?MTP_DRAFT_MAX[[:space:]]*=' "$CONFIG" && CONFIG_HAS_MTP_DRAFT_MAX=1
    # Strip obsolete vLLM/Mirai settings before sourcing
    _pmm_tmp=$(mktemp 2>/dev/null) || true
    if [ -n "$_pmm_tmp" ]; then
        grep -vE '^(export[[:space:]]+)?(VLLM_|MIRAI_|BACKEND=|PLUGIN=|PLUGIN_DIR=|PMM_PLUGIN_)' "$CONFIG" > "$_pmm_tmp" 2>/dev/null || true
        source "$_pmm_tmp"
        rm -f "$_pmm_tmp"
    else
        source "$CONFIG"
    fi
    sanitize_settings "$CONFIG"
fi
SAVED_MODEL_ROOT="$MODEL_ROOT"
SAVED_PRISM_ROOT="$PRISM_ROOT"
SAVED_SERVER_BIN="$SERVER_BIN"
SAVED_BENCH_BIN="$BENCH_BIN"
MODEL_ROOT="${PMM_MODEL_ROOT:-$MODEL_ROOT}"
PRISM_ROOT="${PMM_PRISM_ROOT:-$PRISM_ROOT}"
SERVER_BIN="${PMM_SERVER_BIN:-$SERVER_BIN}"
BENCH_BIN="${PMM_BENCH_BIN:-$BENCH_BIN}"

# Migrate legacy SPEC_* settings only when their canonical counterpart was not
# explicitly saved. SPEC_DRAFT_MODEL has no canonical sidecar path because 3.0
# supports embedded MTP only; it enables embedded MTP while retaining a warning.
if [ -n "${SPEC_MODE:-}" ] && [ "$CONFIG_HAS_MTP_MODE" -eq 0 ]; then
    MTP_MODE="$SPEC_MODE"
fi
if [ -n "${SPEC_MODE:-}" ] && [ "$CONFIG_HAS_MTP" -eq 0 ]; then
    MTP=on
fi
if [ -n "${SPEC_DRAFT_MODEL:-}" ] && [ "$CONFIG_HAS_MTP" -eq 0 ]; then
    MTP=on
fi
if [ -n "${SPEC_DRAFT_TOKENS:-}" ] && [ "$CONFIG_HAS_MTP_DRAFT_MAX" -eq 0 ]; then
    MTP_DRAFT_MAX="$SPEC_DRAFT_TOKENS"
fi
LEGACY_SPEC_DRAFT_MODEL_SET=0
[ -n "${SPEC_DRAFT_MODEL:-}" ] && LEGACY_SPEC_DRAFT_MODEL_SET=1

LLAMA_DIR="$BACKENDS_DIR/llama.cpp"

for candidate in "$PRISM_ROOT/build-cuda/bin/llama-server" "$PRISM_ROOT/build/bin/llama-server" "$PRISM_ROOT/llama-server" "$LLAMA_DIR/llama-server"; do
    if [ -z "$SERVER_BIN" ] && [ -x "$candidate" ]; then SERVER_BIN="$candidate"; fi
done
SERVER_BIN="${SERVER_BIN:-$(command -v llama-server || true)}"
# If SERVER_BIN didn't resolve from PATH, check PMM-managed backend directory
if [ -z "$SERVER_BIN" ] && [ -x "$LLAMA_DIR/llama-server" ]; then
    SERVER_BIN="$LLAMA_DIR/llama-server"
fi
BENCH_BIN="${BENCH_BIN:-${SERVER_BIN%/*}/llama-bench}"

SCORE_BIN="${PMM_SCORE_BIN:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/prism-lora-ab-score.py}"
BACKEND_MANAGER="${PMM_BACKEND_MANAGER:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/prism-backend-manager}"
MODEL_DETECT_PY="${PMM_MODEL_DETECT_PY:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/prism-model-detect.py}"


