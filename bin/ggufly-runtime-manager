#!/usr/bin/env bash
# ggufly-runtime-manager — GGUFly runtime installer, updater, remover
#
# Architecture:
#   - GGUFly is GGUF + llama.cpp focused
#   - No vLLM or Python plugin support
#   - Managed runtimes: standard (llama.cpp), prism (PrismML/Bonsai), mirai (Mirai S)
#   - External runtimes: any llama-server binary folder
#   - Uses ggufly-runtime-registry.sh for all runtime operations
#
# Usage:
#   ggufly-runtime-manager status [runtime-id]
#   ggufly-runtime-manager install [standard|prism|mirai]
#   ggufly-runtime-manager remove [standard|prism|mirai]
#   ggufly-runtime-manager detect
#
set -uo pipefail
umask 077

# ── Resolve paths ─────────────────────────────
SCRIPT_DIR=$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/ggufly"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/ggufly"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"

BACKENDS_DIR="$DATA_HOME/ggufly/backends"
LLAMA_DIR="$BACKENDS_DIR/llama.cpp"
DOWNLOAD_CACHE="$STATE_DIR/downloads"
SOURCE_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/ggufly/sources"

COMPAT_FILE="${COMPAT_FILE:-$SCRIPT_DIR/../compatibility.json}"
[ -f "$COMPAT_FILE" ] || COMPAT_FILE="$SCRIPT_DIR/compatibility.json"
[ -f "$COMPAT_FILE" ] || COMPAT_FILE="/usr/local/share/ggufly/compatibility.json"

RUNTIME_REGISTRY="$SCRIPT_DIR/ggufly-runtime-registry.sh"

VERBOSE="${PMM_VERBOSE:-0}"

log() { echo "$@" >&2; }
debug() { [ "$VERBOSE" -ge 1 ] && echo "[DEBUG] $*" >&2 || true; }

# Ensure runtime registry initialized
init_registry() {
    if [ -x "$RUNTIME_REGISTRY" ]; then
        "$RUNTIME_REGISTRY" init 2>/dev/null || true
    fi
}

# ── Detect system capabilities ────────────────

detect_system() {
    local json
    json=$(python3 -c "
import json, shutil, subprocess, sys

result = {
    'gpu_name': None,
    'gpu_count': 0,
    'vram_total_mib': 0,
    'compute_capability': None,
    'compute_arch': None,
    'driver_version': None,
    'llama_cuda_compatible': False,
    'system_ram_gib': 0,
    'system_ram_available_gib': 0,
}

# RAM
try:
    with open('/proc/meminfo') as f:
        for line in f:
            if line.startswith('MemTotal:'):
                result['system_ram_gib'] = int(line.split()[1]) // 1048576
            elif line.startswith('MemAvailable:'):
                result['system_ram_available_gib'] = int(line.split()[1]) // 1048576
except: pass

# GPU
try:
    rows = subprocess.check_output(
        ['nvidia-smi', '--query-gpu=name,memory.total,compute_cap', '--format=csv,noheader'],
        timeout=5, text=True).strip().splitlines()
    for i, row in enumerate(rows):
        parts = [p.strip() for p in row.split(',')]
        if len(parts) >= 3:
            result['gpu_name'] = result['gpu_name'] or parts[0]
            result['gpu_count'] += 1
            vram = int(parts[1].split()[0]) if parts[1].split()[0].isdigit() else 0
            result['vram_total_mib'] += vram
            cc = float(parts[2])
            result['compute_capability'] = cc
            # Architecture string
            if cc >= 9.0: result['compute_arch'] = 'Hopper'
            elif cc >= 8.9: result['compute_arch'] = 'Ada'
            elif cc >= 8.0: result['compute_arch'] = 'Ampere'
            elif cc >= 7.5: result['compute_arch'] = 'Turing'
            else: result['compute_arch'] = 'Pre-Turing'

    result['llama_cuda_compatible'] = result['gpu_count'] > 0
except: pass

# CUDA version
try:
    cuda = subprocess.run(['nvidia-smi'], capture_output=True, text=True, timeout=5)
    m = __import__('re').search(r'CUDA\s+Version:\s*([0-9.]+)', cuda.stdout)
    if m: result['cuda_version'] = m.group(1)
except: pass

print(json.dumps(result))
" 2>/dev/null) || {
        cat <<'FALLBACK'
{
  "gpu_name": null,
  "gpu_count": 0,
  "vram_total_mib": 0,
  "compute_capability": null,
  "compute_arch": null,
  "driver_version": null,
  "cuda_version": null,
  "llama_cuda_compatible": false,
  "system_ram_gib": 0,
  "system_ram_available_gib": 0
}
FALLBACK
    }
    echo "$json"
}

detect_key() {
    local key="$1"
    detect_system | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('$key','') or '')" 2>/dev/null || echo ''
}

# ── Compatibility manifest ────────────────────

read_manifest() {
    if [ ! -f "$COMPAT_FILE" ]; then
        log "ERROR: compatibility manifest not found at $COMPAT_FILE"
        return 1
    fi
    python3 -c "
import json, sys
with open('$COMPAT_FILE') as f:
    data = json.load(f)
for key in sys.argv[1:]:
    keys = key.split('.')
    val = data
    try:
        for k in keys:
            val = val[k]
    except (KeyError, TypeError):
        print('')
        sys.exit(1)
    if isinstance(val, str):
        print(val)
    elif isinstance(val, bool):
        print(str(val).lower())
    elif isinstance(val, (int, float)):
        print(val)
    else:
        print(json.dumps(val))
" "$@" 2>/dev/null || echo ''
}

# ── CUDA build detection ─────────────────────

detect_cuda_arch() {
    # Detect the appropriate CUDA architecture for this host
    local cap
    cap=$(detect_key "compute_capability" 2>/dev/null || echo "")

    if [ -z "$cap" ] || [ "$cap" = "None" ]; then
        # Fallback: check nvcc
        if command -v nvcc >/dev/null 2>&1; then
            local nvcc_arch
            nvcc_arch=$(nvcc --version 2>/dev/null | grep -oP 'release \K[0-9.]+' || echo "")
            if [ -n "$nvcc_arch" ]; then
                echo "${nvcc_arch%%.*}"
                return 0
            fi
        fi
        echo "89"  # RTX 4070 SUPER default
        return 0
    fi

    # Convert compute capability to architecture number (remove dot)
    python3 -c "
cap = float('$cap')
# Map to CMAKE_CUDA_ARCHITECTURES
if cap >= 10.0: print('100')
elif cap >= 9.0: print('90')
elif cap >= 8.9: print('89')
elif cap >= 8.6: print('86')
elif cap >= 8.0: print('80')
elif cap >= 7.5: print('75')
elif cap >= 7.0: print('70')
else: print('89')
" 2>/dev/null || echo "89"
}

detect_cuda_toolkit() {
    local nvcc_path=""
    if command -v nvcc >/dev/null 2>&1; then
        nvcc_path=$(command -v nvcc)
    elif [ -f /usr/local/cuda/bin/nvcc ]; then
        nvcc_path=/usr/local/cuda/bin/nvcc
    elif [ -f /opt/cuda/bin/nvcc ]; then
        nvcc_path=/opt/cuda/bin/nvcc
    fi

    if [ -n "$nvcc_path" ]; then
        local cuda_version
        cuda_version=$("$nvcc_path" --version 2>/dev/null | grep -oP 'release \K[0-9.]+' || echo "unknown")
        local cuda_home
        cuda_home=$(dirname "$(dirname "$nvcc_path")")
        echo "$cuda_version|$cuda_home|$nvcc_path"
    else
        echo "unknown||"
    fi
}

# ── Source management ──────────────────────────

get_runtime_source() {
    local runtime_id="$1"
    local repo ref
    repo=$(read_manifest "backends.${runtime_id}.source_repo" 2>/dev/null || echo "")
    ref=$(read_manifest "backends.${runtime_id}.pinned_commit" 2>/dev/null || echo "")
    echo "${repo:-not_found}|${ref:-not_found}"
}

source_cache_dir() {
    local runtime_id="$1"
    local dir
    dir=$(read_manifest "backends.${runtime_id}.source_cache_dir" 2>/dev/null) || dir="${SOURCE_CACHE}/${runtime_id}"
    dir="${dir//\{source_cache\}/$SOURCE_CACHE}"
    echo "$dir"
}

# ── Managed runtime installers ────────────────

install_standard() {
    log "=== Installing Standard llama.cpp ==="
    local target_dir="$LLAMA_DIR/standard"
    mkdir -p "$target_dir"

    # Get source info
    local repo ver
    repo=$(read_manifest "backends.standard_llamacpp.source_repo" 2>/dev/null || echo "https://github.com/ggml-org/llama.cpp")
    ver=$(read_manifest "backends.standard_llamacpp.pinned_version" 2>/dev/null || echo "b5098")

    log "Source: $repo @ $ver"

    # Try prebuilt binary first
    local release_url
    release_url=$(read_manifest "backends.standard_llamacpp.linux_amd64_cuda.url_template" 2>/dev/null)
    if [ -n "$release_url" ]; then
        release_url="${release_url//\{version\}/$ver}"
        log "Downloading prebuilt: $release_url"
        local downloaded
        downloaded=$(download_file "$release_url" "$DOWNLOAD_CACHE") || {
            log "WARNING: Prebuilt download failed, falling back to build..."
            build_from_source "standard" "$repo" "$ver" "$target_dir"
            return $?
        }

        # Extract
        log "Extracting..."
        if [[ "$downloaded" == *.zip ]]; then
            if ! command -v unzip >/dev/null 2>&1; then
                log "ERROR: unzip required"
                return 1
            fi
            local extract_dir="$DOWNLOAD_CACHE/extract-standard"
            rm -rf "$extract_dir"
            mkdir -p "$extract_dir"
            unzip -q -o "$downloaded" -d "$extract_dir/" 2>&1 || {
                log "ERROR: Extraction failed"; return 1
            }

            # Find and install llama-server
            local extracted_server
            extracted_server=$(find "$extract_dir" -name "llama-server" -type f 2>/dev/null | head -1)
            if [ -z "$extracted_server" ]; then
                log "ERROR: llama-server not found in archive"
                return 1
            fi

            mkdir -p "$target_dir/bin"
            cp "$extracted_server" "$target_dir/bin/llama-server"
            chmod +x "$target_dir/bin/llama-server"

            local extracted_bench
            extracted_bench=$(find "$extract_dir" -name "llama-bench" -type f 2>/dev/null | head -1)
            if [ -n "$extracted_bench" ]; then
                cp "$extracted_bench" "$target_dir/bin/llama-bench"
                chmod +x "$target_dir/bin/llama-bench"
            fi

            rm -rf "$extract_dir"
        else
            log "ERROR: Unsupported archive format"
            return 1
        fi
    else
        log "No prebuilt URL in manifest, building from source..."
        build_from_source "standard" "$repo" "$ver" "$target_dir"
        return $?
    fi

    # Verify
    if [ -x "$target_dir/bin/llama-server" ]; then
        local ver_out
        ver_out=$("$target_dir/bin/llama-server" --version 2>&1 | head -1)
        log "Installed: $ver_out"
        write_manifest "$target_dir" "standard" "$repo" "$ver" "$ver_out"
        update_symlink "$LLAMA_DIR/standard"
        log "Standard llama.cpp installed at $target_dir"
        return 0
    fi

    log "ERROR: Installation verification failed"
    return 1
}

install_prism() {
    log "=== Installing PrismML / Bonsai runtime ==="
    local target_dir="$LLAMA_DIR/prism"
    mkdir -p "$target_dir"

    local repo commit
    repo=$(read_manifest "backends.prism.source_repo" 2>/dev/null || echo "https://github.com/PrismML-Eng/llama.cpp")
    commit=$(read_manifest "backends.prism.pinned_commit" 2>/dev/null || echo "3443ddece08c8d1bd888e80b181c4edb53a3d553")

    log "Source: $repo @ $commit"
    build_from_source "prism" "$repo" "$commit" "$target_dir"
}

install_mirai() {
    log "=== Installing Mirai S runtime ==="
    local target_dir="$LLAMA_DIR/mirai"
    mkdir -p "$target_dir"

    local repo commit
    repo=$(read_manifest "backends.mirai.source_repo" 2>/dev/null || echo "https://github.com/alesha-pro/llama.cpp-mirai-s")
    commit=$(read_manifest "backends.mirai.pinned_commit" 2>/dev/null || echo "b59ae80f419a5415cb950f2a7b2284a500fe74cb")

    log "Source: $repo @ $commit"
    build_from_source "mirai" "$repo" "$commit" "$target_dir"
}

# ── Build from source ─────────────────────────

build_from_source() {
    local runtime_id="$1" repo="$2" ref="$3" target_dir="$4"
    local source_dir
    source_dir=$(source_cache_dir "$runtime_id")

    log "Source directory: $source_dir"

    # Clone or update
    if [ -d "$source_dir/.git" ]; then
        log "Updating existing source..."
        (cd "$source_dir" && git fetch --depth 1 origin "$ref" 2>&1 | tail -3) || {
            log "WARNING: git fetch failed, using existing source"
        }
    else
        log "Cloning source..."
        mkdir -p "$(dirname "$source_dir")"
        git clone --depth 1 --branch "$ref" "$repo" "$source_dir" 2>&1 | tail -5 || {
            # Try with just commit
            rm -rf "$source_dir"
            git clone "$repo" "$source_dir" 2>&1 | tail -5 || {
                log "ERROR: Failed to clone repository"
                return 1
            }
            (cd "$source_dir" && git checkout "$ref" 2>&1) || {
                log "ERROR: Failed to checkout ref"
                return 1
            }
        }
    fi

    local actual_commit
    actual_commit=$(cd "$source_dir" && git rev-parse HEAD 2>/dev/null || echo "$ref")

    # Detect CUDA
    local cuda_arch cuda_toolkit_info
    cuda_arch=$(detect_cuda_arch)
    cuda_toolkit_info=$(detect_cuda_toolkit)
    local cuda_version cuda_home nvcc_path
    IFS='|' read -r cuda_version cuda_home nvcc_path <<< "$cuda_toolkit_info"

    log "CUDA architecture: $cuda_arch"
    log "CUDA toolkit: ${cuda_version:-not found} at ${cuda_home:-none}"
    log "Building llama.cpp runtime (this may take several minutes)..."

    # Build directory
    local build_dir="$source_dir/build-cuda-v4"
    mkdir -p "$build_dir"

    local cmake_args=(
        -DCMAKE_BUILD_TYPE=Release
        -DGGML_CUDA=ON
        -DGGML_CUDA_FORCE_MMQ=OFF
        -DCMAKE_CUDA_ARCHITECTURES="$cuda_arch"
    )

    if [ -n "$cuda_home" ] && [ "$cuda_home" != "" ] && [ -d "$cuda_home" ]; then
        cmake_args+=(-DCMAKE_CUDA_COMPILER="$cuda_home/bin/nvcc")
    fi

    # Configure
    log "CMake configuration..."
    cmake -S "$source_dir" -B "$build_dir" "${cmake_args[@]}" 2>&1 | tail -10 || {
        log "ERROR: CMake configuration failed"
        log "Try with different CUDA architecture or check CUDA toolkit"
        return 1
    }

    # Build
    log "Building..."
    local nproc
    nproc=$(nproc 2>/dev/null || echo 4)
    cmake --build "$build_dir" --target llama-server -- -j"$nproc" 2>&1 | tail -10 || {
        log "ERROR: Build failed for llama-server"
        # Try building all targets
        cmake --build "$build_dir" -j"$nproc" 2>&1 | tail -10 || {
            log "ERROR: Build failed"
            return 1
        }
    }

    # Build llama-bench if possible
    cmake --build "$build_dir" --target llama-bench -j"$nproc" 2>&1 | tail -5 || true

    # Install
    mkdir -p "$target_dir/bin"

    if [ -f "$build_dir/bin/llama-server" ]; then
        cp "$build_dir/bin/llama-server" "$target_dir/bin/"
    elif [ -f "$build_dir/examples/server/llama-server" ]; then
        cp "$build_dir/examples/server/llama-server" "$target_dir/bin/"
    elif [ -f "$build_dir/llama-server" ]; then
        cp "$build_dir/llama-server" "$target_dir/bin/"
    else
        log "ERROR: llama-server binary not found after build"
        find "$build_dir" -name "llama-server" -type f 2>/dev/null
        return 1
    fi

    if [ -f "$build_dir/bin/llama-bench" ]; then
        cp "$build_dir/bin/llama-bench" "$target_dir/bin/"
    fi

    chmod +x "$target_dir/bin/llama-server" 2>/dev/null || true

    # Copy libs
    if [ -d "$build_dir/lib" ]; then
        cp -r "$build_dir/lib" "$target_dir/"
    fi

    # Verify
    local ver_out=""
    ver_out=$(timeout 5 "$target_dir/bin/llama-server" --version 2>&1 | head -1) || {
        log "WARNING: llama-server binary verification failed (might be missing libs)"
        ldd "$target_dir/bin/llama-server" 2>&1 | grep "not found" | head -5 >&2 || true
        rm -rf "$target_dir/bin"
        return 1
    }

    log "Build verified: $ver_out"
    write_manifest "$target_dir" "$runtime_id" "$repo" "$actual_commit" "$ver_out" "$cuda_arch" "$cuda_version"
    update_symlink "$LLAMA_DIR/$runtime_id"
    log "$(runtime_display_name "$runtime_id" 2>/dev/null || echo "$runtime_id") installed at $target_dir"
    return 0
}

# ── Manifest helpers ──────────────────────────

write_manifest() {
    local target_dir="$1" runtime_id="$2" repo="$3" ref="$4" version="$5"
    local cuda_arch="${6:-}" cuda_toolkit="${7:-}"
    local installed_at
    installed_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)

    python3 -c "
import json, os
manifest = {
    'runtime_id': '$runtime_id',
    'display_name': '$(runtime_display_name "$runtime_id" 2>/dev/null || echo "$runtime_id")',
    'source_repo': '$repo',
    'source_ref': '$ref',
    'installed_at': '$installed_at',
    'cuda_enabled': '${cuda_arch:+true}' or 'false',
    'cuda_arch': '${cuda_arch:-}',
    'cuda_toolkit': '${cuda_toolkit:-}',
    'version': json.dumps('$version').strip('\"') if '$version' else 'unknown',
}
with open(os.path.join('$target_dir', 'manifest.json'), 'w') as f:
    json.dump(manifest, f, indent=2)
" 2>/dev/null || {
        # Fallback shell version
        cat > "$target_dir/manifest.json" <<MANIFEST
{
  "runtime_id": "$runtime_id",
  "installed_at": "$installed_at",
  "source_ref": "$ref",
  "cuda_enabled": ${cuda_arch:+true}${cuda_arch:-false}
}
MANIFEST
    }
}

# Safely atomically update a "current" symlink
update_symlink() {
    local runtime_dir="$1"
    local version_dir
    version_dir=$(readlink -f "$runtime_dir/../"* 2>/dev/null | grep -v "current" | head -1)

    # Find the version subdirectory (most recent)
    local latest=""
    for d in "$runtime_dir"/*/; do
        [ -d "$d" ] && [ "$(basename "$d")" != "current" ] && latest="$d"
    done

    if [ -z "$latest" ] && [ -d "$runtime_dir/bin" ]; then
        # Flat install (no version subdirectories)
        return 0
    fi

    if [ -n "$latest" ]; then
        local tmp_link="${runtime_dir}/current.tmp"
        ln -sf "$(basename "$latest")" "$tmp_link" 2>/dev/null || {
            # Fallback: use the dir basename
            ln -sf "$(basename "$latest")" "$tmp_link" 2>/dev/null || true
        }
        mv -f "$tmp_link" "${runtime_dir}/current" 2>/dev/null || true
    fi
}

remove_runtime() {
    local runtime_id="$1"

    if [ "$runtime_id" = "standard" ] || [ "$runtime_id" = "prism" ] || [ "$runtime_id" = "mirai" ]; then
        local target_dir="$LLAMA_DIR/$runtime_id"
        if [ -d "$target_dir" ]; then
            log "=== Removing $runtime_id runtime ==="
            # Remove version directories but preserve current symlink info
            for d in "$target_dir"/*/; do
                local b
                b=$(basename "$d")
                [ "$b" = "current" ] && continue
                rm -rf "$d"
                log "  Removed: $d"
            done
            rm -f "$target_dir/current"
            log "Removed: $target_dir"
        else
            log "Runtime '$runtime_id' not installed."
        fi
    else
        log "Removing non-managed runtimes is not supported by this command."
        log "Use 'ggufly-runtime-registry.sh unregister $runtime_id' to remove the registry entry."
    fi
}

# ── Download helper ───────────────────────────

download_file() {
    local url="$1" dest_dir="$2" dest_name="${3:-}"
    mkdir -p "$dest_dir" "$DOWNLOAD_CACHE"

    if [ -z "$dest_name" ]; then
        dest_name=$(basename "${url%%\?*}")
    fi

    local dest="$dest_dir/$dest_name"
    if [ -f "$dest" ]; then
        log "  Already cached: $dest_name"
        echo "$dest"
        return 0
    fi

    log "  Downloading $dest_name..."
    if command -v curl >/dev/null 2>&1; then
        curl --noproxy '*' -fsSL --connect-timeout 15 --max-time 300 \
            -o "$dest" "$url" 2>&1 || {
            log "ERROR: Download failed for $url"
            rm -f "$dest"
            return 1
        }
    elif command -v wget >/dev/null 2>&1; then
        wget -q --timeout=15 --tries=2 -O "$dest" "$url" 2>&1 || {
            log "ERROR: Download failed for $url"
            rm -f "$dest"
            return 1
        }
    else
        log "ERROR: Neither curl nor wget available"
        return 1
    fi

    [ -s "$dest" ] || { log "ERROR: Downloaded file is empty"; rm -f "$dest"; return 1; }
    echo "$dest"
}

# ── Runtime status ────────────────────────────

runtime_status() {
    local runtime_id="$1"
    local managed installed

    # Check if registered
    if ! "$RUNTIME_REGISTRY" get "$runtime_id" id >/dev/null 2>&1; then
        echo "not_registered"
        return 1
    fi

    managed=$(runtime_registry_get "$runtime_id" "managed" 2>/dev/null || echo "false")

    if [ "$managed" = "true" ]; then
        # Managed runtime
        local folder
        folder=$("$RUNTIME_REGISTRY" get "$runtime_id" "folder" 2>/dev/null)
        local expanded
        expanded="${folder/#\~/$HOME}"

        if [ -d "$expanded" ] && [ -x "$expanded/bin/llama-server" ]; then
            local ver
            ver=$(timeout 3 "$expanded/bin/llama-server" --version 2>&1 | head -1 || echo "unknown")
            echo "installed:$ver"
            return 0
        elif [ -d "$expanded" ]; then
            # Check if symlink resolves
            local resolved
            resolved=$(readlink -f "$expanded" 2>/dev/null || echo "")
            if [ -n "$resolved" ] && [ -x "$resolved/bin/llama-server" ]; then
                local ver
                ver=$(timeout 3 "$resolved/bin/llama-server" --version 2>&1 | head -1 || echo "unknown")
                echo "installed:$ver"
                return 0
            fi
            echo "not_installed"
            return 1
        else
            echo "not_installed"
            return 1
        fi
    else
        # External runtime - check if folder exists and binary is valid
        local folder
        folder=$("$RUNTIME_REGISTRY" get "$runtime_id" "folder" 2>/dev/null)
        local expanded
        expanded="${folder/#\~/$HOME}"

        if [ -d "$expanded" ]; then
            local binary
            binary=$("$RUNTIME_REGISTRY" get "$runtime_id" "binary" 2>/dev/null || echo "")
            if [ -n "$binary" ] && [ -x "$binary" ]; then
                local ver
                ver=$(timeout 3 "$binary" --version 2>&1 | head -1 || echo "unknown")
                echo "external:$ver"
                return 0
            fi
            # Try to discover
            binary=$("$RUNTIME_REGISTRY" discover "$expanded" 2>/dev/null | head -1) || {
                echo "external:no_binary"
                return 1
            }
            if [ -x "$binary" ]; then
                local ver
                ver=$(timeout 3 "$binary" --version 2>&1 | head -1 || echo "unknown")
                echo "external:$ver"
                return 0
            fi
            echo "external:no_binary"
            return 1
        else
            echo "external:missing_folder"
            return 1
        fi
    fi
}

runtime_registry_get() {
    local id="$1" key="$2"
    "$RUNTIME_REGISTRY" get "$id" "$key" 2>/dev/null || true
}

runtime_display_name() {
    runtime_registry_get "$1" "display_name" || echo "$1"
}

status_all() {
    echo "=== Runtime Status ==="

    init_registry

    local ids
    ids=$("$RUNTIME_REGISTRY" list 2>/dev/null || echo "")

    if [ -z "$ids" ]; then
        echo "No runtimes registered."
        return
    fi

    local first=true
    local id status display
    while IFS= read -r id; do
        [ -n "$id" ] || continue
        display=$(runtime_display_name "$id")
        status=$(runtime_status "$id" 2>/dev/null || echo "not_installed")
        printf '%-30s %s\n' "$display:" "$status"
    done <<< "$ids"

    echo ""
    echo "GPU:        $(detect_key 'gpu_name' 2>/dev/null || echo 'N/A')"
    echo "VRAM:       $(detect_key 'vram_per_gpu_mib' 2>/dev/null || echo 'N/A') MiB"
    echo "Compute:    $(detect_key 'compute_capability' 2>/dev/null || echo 'N/A')"
    echo "CUDA:       $(detect_key 'cuda_version' 2>/dev/null || echo 'N/A')"
    echo "RAM:        $(detect_key 'system_ram_gib' 2>/dev/null || echo 'N/A') GiB"
}

# ── Main dispatcher ──────────────────────────

case "${1:-}" in
    detect)
        detect_system
        ;;
    status)
        init_registry
        if [ -n "${2:-}" ]; then
            runtime_status "$2"
        else
            status_all
        fi
        ;;
    install)
        init_registry
        case "${2:-}" in
            standard|llama.cpp)
                install_standard
                ;;
            prism|prismml|bonsai)
                install_prism
                ;;
            mirai|mirai_s)
                install_mirai
                ;;
            *)
                echo "Usage: ggufly-runtime-manager install [standard|prism|mirai]" >&2
                exit 1
                ;;
        esac
        ;;
    remove)
        case "${2:-}" in
            standard|prism|mirai) remove_runtime "$2" ;;
            llama.cpp) remove_runtime "standard" ;;
            *)
                echo "Usage: ggufly-runtime-manager remove [standard|prism|mirai]" >&2
                exit 1
                ;;
        esac
        ;;
    *)
        echo "Usage:"
        echo "  ggufly-runtime-manager detect              Print system detection JSON"
        echo "  ggufly-runtime-manager status [runtime]    Show installation status"
        echo "  ggufly-runtime-manager install [standard|prism|mirai]  Install a runtime"
        echo "  ggufly-runtime-manager remove [standard|prism|mirai]   Remove a runtime"
        echo ""
        echo "GGUFly GGUF-focused edition. No vLLM support."
        echo "Use ggufly-runtime-registry.sh for runtime registration."
        exit 1
        ;;
esac