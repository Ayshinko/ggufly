# Trusted Bash configuration. Copy manually to:
# ${XDG_CONFIG_HOME:-$HOME/.config}/prism-model-manager/config.env
#
# Recommended values for a ternary PTQ1_0 + embedded-MTP Bonsai model on a 12 GB
# GPU (RTX 4070 SUPER, PR #218 fork build): CTX=40960, CTK=q8_0, CTV=q8_0,
# BATCH=2048, UBATCH=512, NGL=99, MTP=on, MTP_MODE=draft-mtp, MTP_DRAFT_MAX=1.
# Those settings measured ~9.2 GB VRAM and fit with headroom. The defaults below
# are conservative generic starting values, not a VRAM-fit promise.
MODEL_ROOT="$HOME/Models"
# Runtime selection is per-model via the runtime registry.
# Use PMM_SERVER_BIN only for session overrides (not persisted).
HOST=127.0.0.1
PORT=8080
CTX=4096
NGL=99
FLASH=on
BATCH=512
UBATCH=128
PARALLEL=1
CACHE_K=f16
CACHE_V=f16
LORA_ENABLED=off
LORA_PATH=""
LORA_SCALE=2

# Model/runtime capabilities still require a compatible custom backend.
VISION=off
MMPROJ_PATH=""
MTP=off
MTP_MODE=draft-mtp
MTP_DRAFT_MAX=3
MTP_DRAFT_FLAG=--spec-draft-n-max
STARTUP_TIMEOUT=180